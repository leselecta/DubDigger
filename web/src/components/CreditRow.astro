---
import { listGrid } from "./list-grid";

interface Props {
  /** Omitted drops the column entirely. Keep it in step with `ListHeader`. */
  count?: string | number;
  href: string;
  name: string;
  /** Long text, wrapped under the name. Roles, mostly. */
  detail?: string | null;
  /** Short text for the third column. Years, a catalogue number. */
  meta?: string | null;
  /**
   * What the third column is called, printed in front of the value once the
   * column has folded under the name.
   *
   * It repeats the string given to `ListHeader`'s `meta`, and it has to: the
   * header and the rows are separate components, and there is no way for one
   * to read the other's props. Keep the two in step — a row that says
   * "Active:" under a column headed "Cat no." is worse than no label at all.
   */
  metaLabel?: string;
  /**
   * The name leaves the site. Marks the row with an arrow, opens a new tab, and
   * says both in the accessible name, since a link that behaves differently
   * should look and sound different before it is followed.
   */
  external?: boolean;
}

const { count, href, name, detail, meta, metaLabel, external = false } = Astro.props;

const nameClass = "link-rule text-row justify-self-start font-bold tracking-[-0.01em]";

/*
 * A column heading that already ends in a full stop keeps it in the header row
 * and loses it here, where the colon does that job: "Cat no.:" is the same
 * pause twice. Stripped in the component rather than at the call sites so they
 * can go on passing the header's own string verbatim, which is what keeps the
 * two from drifting apart.
 */
const metaHeading = metaLabel?.replace(/\.$/, "");

/*
 * Whether there is a third column at all. The slot counts: a row can put a link
 * where the plain string usually goes, and that is still a filled column. When
 * nothing fills it the cell is not drawn, because an empty `md:col-start-3` in
 * a two-column grid opens an implicit third track and puts the dead strip back.
 */
const hasMeta = Boolean(meta) || Boolean(metaHeading) || Astro.slots.has("meta");
---

<li
  class:list={[
    "border-hairline-soft grid items-baseline gap-x-[22px] border-b py-[18px]",
    listGrid(Boolean(count), hasMeta),
  ]}
>
  <div class="min-w-0">
    {/*
     * After the title and outside the anchor. Outside so `link-rule` stays
     * under the title rather than running on beneath the glyph, and closed up
     * against it so the gap is the margin and nothing else: a newline between
     * the two would collapse to a space and widen it.
     */}
    <a
      href={href}
      class={nameClass}
      target={external ? "_blank" : undefined}
      rel={external ? "noreferrer" : undefined}
      >{name}{external && <span class="sr-only">on Discogs, opens in a new tab</span>}</a
    >{external && (
      <svg
        class="text-ink-faint ml-2 inline-block align-baseline"
        width="10"
        height="10"
        viewBox="0 0 10 10"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1.6 8.4L8.4 1.6M4.4 1.6h4v4"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )}
    {
      detail && (
        <p class="text-ink-dim mt-2 max-w-[920px] font-mono text-xs leading-[1.65]">{detail}</p>
      )
    }
  </div>

  {
    count && (
      <span class="text-ink-faint font-mono text-[0.8125rem] font-medium tabular-nums">{count}</span>
    )
  }

  {
    hasMeta && (
      <span
        class:list={[
          "text-ink-faint col-start-1 mt-2 font-mono text-[0.8125rem] tabular-nums md:mt-0",
          count ? "md:col-start-3" : "md:col-start-2",
        ]}
      >
        {/*
         * The column header, brought down to the value.
         *
         * `mt-2` for the row gap the grid does not have. The name above carries
         * `link-rule`, and with no gap the underline's bottom and this line's top
         * are the same y. It only shows when the name wraps: short, the rule is as
         * wide as the word and sits nowhere near this; wrapped, the name fills the
         * column and a full-width rule lands flat on the meta line. Dropped at `md`,
         * where this is back in column three of a single row.
         *
         * This column drops under the name below `md`, where `ListHeader` has no
         * room to keep its own heading — so a bare "2002 – 2026" sat under a title
         * with nothing saying what it counted. It reads "Active: 2002 – 2026" on a
         * phone and goes back to being a column, unlabelled, from `md` up.
         *
         * Unlabelled to the eye, that is. `md:sr-only` takes it out of the flow
         * without taking it out of the accessible tree, which `md:hidden` did:
         * `ListHeader` is a sibling `<div>` and cannot tell a screen reader which
         * column it heads, so above `md` the value was read on its own with nothing
         * saying what it counted — the same fault the phone layout was fixing.
         *
         * The space between the two is the newline below, which HTML renders as
         * one. Nothing sets it, so nothing can set it twice; out of flow, the
         * browser drops it at the start of the line and the column does not shift.
         */}
        {metaHeading && <span class="md:sr-only">{metaHeading}:</span>}
        {/* A slot so a row can put a link here, with the plain string as the usual case. */}
        <slot name="meta">{meta}</slot>
      </span>
    )
  }
</li>

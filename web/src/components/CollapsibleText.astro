---
/**
 * Bio and label info, clamped with a fade until asked to open.
 *
 * The control only appears when the text actually overflows the clamp, which
 * cannot be known from the server: it depends on the rendered line count at
 * this viewport. So the height is measured after paint, and a short bio simply
 * renders as a paragraph with nothing to click.
 *
 * Unclamped in the markup, clamped by the script. That order is deliberate:
 * with no JavaScript the whole bio is readable, where clamping first would
 * leave a reader stuck at four lines with no way to open them.
 */
---

<div class="max-w-[720px]" data-collapsible>
  {/*
   * The opening itself is a CSS transition, so the script only ever sets two
   * pixel values and the browser does the rest. `motion-reduce` turns it off
   * for a reader who has asked for that, which a JavaScript animation would
   * have had to check for by hand.
   */}
  <div
    class="relative overflow-hidden transition-[max-height] duration-300 ease-out motion-reduce:transition-none"
    data-clamp
  >
    <div data-inner><slot /></div>
    <div
      class="pointer-events-none absolute right-0 bottom-0 left-0 hidden h-12"
      style="background: linear-gradient(rgb(6 6 6 / 0), rgb(6 6 6))"
      data-fade
    >
    </div>
  </div>

  <button
    type="button"
    hidden
    class="text-ink-muted hover:text-ink mt-8 inline-flex cursor-pointer items-center gap-[9px] font-mono text-xs tracking-[0.16em] uppercase"
    data-toggle
  >
    <span data-toggle-label>Read more</span>
    <span class="inline-flex transition-transform duration-200" data-chevron>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path
          d="M2 4l4 4 4-4"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
</div>

<script>
  /*
   * How much shows before the fade, in pixels rather than lines, because the
   * clamp is a max-height and the text it holds is not always one size.
   *
   * 145 against the bio's 30.4px line is 4.75 lines. Landing on the three
   * quarter line is deliberate and the reason this is not a round number: a
   * clamp that stops on a clean line break reads as the end of the text, and
   * the fade then looks like decoration rather than a cut.
   */
  const CLAMP_PX = 145;

  function setUp(root: HTMLElement) {
    const clamp = root.querySelector<HTMLElement>("[data-clamp]");
    const inner = root.querySelector<HTMLElement>("[data-inner]");
    const fade = root.querySelector<HTMLElement>("[data-fade]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
    const label = root.querySelector<HTMLElement>("[data-toggle-label]");
    const chevron = root.querySelector<HTMLElement>("[data-chevron]");
    if (!clamp || !inner || !fade || !toggle || !label || !chevron) return;

    let open = false;
    let overflows = false;

    /**
     * `animate` is only true for a click. Measuring and the first paint set the
     * height outright, because a bio that slid open on load would be answering
     * a question nobody asked.
     *
     * A transition needs two pixel values, and one end of it is always missing.
     * Opening runs from the clamp, which is already on the element, to the
     * text's own height, since `none` is not a number and cannot be animated
     * towards. Closing runs the other way and has to pin the full height first,
     * because that end is the `none` the open state left behind.
     */
    const paint = (animate = false) => {
      const clamped = overflows && !open;

      if (animate) {
        clamp.style.maxHeight = `${open ? CLAMP_PX : inner.scrollHeight}px`;
        void clamp.offsetHeight;
        clamp.style.maxHeight = `${clamped ? CLAMP_PX : inner.scrollHeight}px`;
      } else {
        clamp.style.maxHeight = clamped ? `${CLAMP_PX}px` : "";
      }

      fade.hidden = !clamped;
      toggle.hidden = !overflows;
      label.textContent = open ? "Collapse" : "Read more";
      chevron.style.transform = open ? "rotate(180deg)" : "";
    };

    // The open state is a height in pixels while it animates, and that number
    // is stale the moment the window narrows and the text rewraps. Dropping it
    // once the transition lands hands the box back to its own content.
    clamp.addEventListener("transitionend", (event) => {
      if (event.propertyName === "max-height" && open) clamp.style.maxHeight = "";
    });

    const measure = () => {
      // Only meaningful while closed: once open the element is its full height
      // by definition, so re-measuring would always report no overflow.
      if (!open) overflows = inner.scrollHeight > CLAMP_PX + 1;
      paint();
    };

    toggle.addEventListener("click", () => {
      open = !open;
      paint(true);
    });

    new ResizeObserver(measure).observe(inner);
    measure();
  }

  // Fires on the first load and again after every ClientRouter navigation.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-collapsible]").forEach(setUp);
  });
</script>

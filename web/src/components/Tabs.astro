---
interface Tab {
  key: string;
  label: string;
  count: number;
}

/**
 * The list switcher on the artist and label pages.
 *
 * Links carrying a search param rather than client state, for three reasons
 * that all point the same way: the lists stay server rendered so a 556 row
 * roster is never serialised into the page as JSON, every tab is a real URL
 * that can be linked and gone back to, and it works before any JavaScript
 * arrives. The ClientRouter in the layout swaps them without a reload, so it
 * still feels like a tab.
 *
 * A tab must not move the page. Switching list is not going anywhere, so the
 * viewport stays exactly where it was and only the rows underneath change,
 * which is how this behaved before the port off React. A fragment was tried
 * first, to keep it a link and spend nothing from the client budget, but a
 * fragment can only say "put the tab bar at the top", and that still moves the
 * page when you switch from a third of the way down.
 *
 * `data-hold-scroll` is what asks for it. The script that honours it lives in
 * the layout, because "Load more" needs the same thing and appears on pages
 * that have no tabs.
 */
interface Props {
  tabs: Tab[];
  active: string;
  basePath: string;
}

const { tabs, active, basePath } = Astro.props;
---

{/*
 * The hairline sits on the wrapper rather than on the scrolling row, so the
 * active tab's heavier underline lands on top of it instead of being clipped
 * away by the scroll container.
 *
 * The margin under it is the gap before the list starts. Two hairlines close
 * together, the tab bar's and the column heads', read as one thick rule and
 * leave the heads looking like part of the switcher rather than the top of the
 * table.
 */}
<div class="border-hairline mb-10 border-b">
  {/*
   * Named, because it is the second `<nav>` on the page: the header's is
   * "Sections", and a reader listing the landmarks needs the two told apart.
   * "Lists" is what this one switches, in the words the page already uses.
   */}
  <nav class="flex gap-6 overflow-x-auto sm:gap-[34px]" aria-label="Lists">
    {
      tabs.map((tab) => {
        const isActive = tab.key === active;
        return (
          <a
            href={tab.key === tabs[0]!.key ? basePath : `${basePath}?tab=${tab.key}`}
            data-hold-scroll
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "shrink-0 pb-4 font-mono text-[0.8125rem] tracking-[0.14em] whitespace-nowrap uppercase",
              isActive ? "text-ink-strong border-b-[1.5px] border-ink-strong" : "text-ink-dim",
            ]}
          >
            {/*
             * The count sits at one grey in both states. It used to take a
             * dimmer shade on the inactive tab, which asked the ramp for a step
             * below `ink-faint` that does not exist, and said the same thing
             * twice: the label already carries which tab you are on.
             */}
            {tab.label}{" "}
            <span class="text-ink-faint">{tab.count.toLocaleString("en-GB")}</span>
          </a>
        );
      })
    }

    {/*
     * The scroll hint, and it only exists where the row can actually overflow.
     *
     * 560px, measured rather than reached for: the widest row the corpus can
     * produce is Andreas Kauffelt's, 45 characters of mono at 13px and 0.14em
     * of tracking plus two 24px gaps, which comes to 482px inside a column
     * that spends 48px on gutters. So a row needs 530px of viewport at the
     * outside and most need about 480. Above that there is nothing to scroll
     * and an arrow would be pointing at nothing. `sm` was the obvious hook and
     * is 640px, which is that lie on every phone held sideways.
     *
     * `sticky` is what pins it to the right edge of the scrollport while the
     * row is scrolled left, and it is a real 48px flex item rather than an
     * overlay hung off the wrapper: at the end of the travel it comes to rest
     * past the last tab instead of sitting on top of the tab it was pointing
     * at. The fade that takes it away there is `scroll-hint` in globals.css,
     * where the reasoning is.
     *
     * The arrow is a grey rather than the accent. Accent marks what you are on
     * or reaching for, and this is neither: it is a note about the shape of the
     * row.
     */}
    <span
      class="scroll-hint pointer-events-none sticky right-0 flex w-12 shrink-0 items-center justify-end pb-4 min-[560px]:hidden"
      style="background: linear-gradient(to right, transparent, var(--color-bg) 65%)"
      aria-hidden="true"
    >
      <svg width="12" height="12" viewBox="0 0 12 12" class="text-ink-dim">
        <path
          d="M4 2l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </nav>
</div>


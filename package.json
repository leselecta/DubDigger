{
  "name": "dub-digger",
  "private": true,
  "version": "0.1.0",
  "description": "A crate-digging tool built on Discogs credit data.",
  "workspaces": [
    "ingest",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "dev": "DUBDIGGER_DB=\"$PWD/../DubDigger/web/data/dubdigger.sqlite\" npm run dev --workspace web -- --port 4322",
    "ingest": "npm run --workspace ingest",
    "preview": "npm run preview --workspace web",
    "start": "npm run start --workspace web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}

---
import { listGrid } from "./list-grid";

interface Props {
  name: string;
  /** Omitted drops the column entirely, header and rows both. */
  count?: string;
  meta?: string;
}

const { name, count, meta } = Astro.props;
---

<div
  class:list={[
    "border-hairline text-ink-faint grid gap-x-[22px] border-b pb-3 font-mono text-[0.6875rem] tracking-[0.2em] uppercase",
    listGrid(Boolean(count), Boolean(meta)),
  ]}
>
  <span>{name}</span>
  {count && <span>{count}</span>}
  {meta && <span class="hidden md:block">{meta}</span>}
</div>

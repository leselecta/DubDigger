---
/**
 * "Let's talk": the contact card, ported from simoneferraro.co.uk.
 *
 * Same content as the original — a heading, the address, and a button that
 * copies it — and a different mechanism. The original hand-rolls a `role`,
 * `aria-modal`, a focus trap, an Escape handler and an `inert` toggle on the
 * page behind. A native `<dialog>` opened with `showModal()` is all of those
 * already: the browser traps focus, closes on Escape, makes the rest of the
 * document inert, returns focus to whatever opened it, and gives a `::backdrop`
 * to paint. What is left to write is opening it, closing it on a backdrop
 * click, and the clipboard.
 *
 * That is also the argument for the fifth entry on the client budget, which
 * CLAUDE.md says has to be made rather than assumed. The behaviour cannot come
 * from the server, since it is a dialog, and this is the cheapest version of it
 * that exists: everything the browser already implements is left to the
 * browser.
 *
 * The trigger degrades. Every opener is a real `mailto:` link, so with no
 * JavaScript a click still reaches the address the dialog would have shown; the
 * script intercepts it and shows the card instead. Nobody lands on a control
 * that does nothing.
 *
 * `inert` here rather than on the drawer is not a contradiction. The drawer is
 * a sheet whose whole point is the page still showing through it, so hiding
 * that page from a screen reader would contradict the design. A modal is the
 * opposite claim: it is the only thing on screen until it is dismissed.
 */
---

<dialog
  data-contact
  aria-labelledby="contact-heading"
  class="bg-bg border-edge-strong m-auto w-[min(26rem,calc(100vw-3rem))] border p-8 text-ink backdrop:bg-black/70"
>
  <button
    data-contact-close
    aria-label="Close"
    class="text-ink-muted hover:text-accent absolute top-4 right-5 cursor-pointer font-mono text-xl leading-none transition-colors"
  >
    &times;
  </button>

  <h2 id="contact-heading" class="text-2xl font-bold tracking-[-0.02em]">
    Let's talk<span class="text-accent">.</span>
  </h2>

  <p class="mono-label mt-5">Drop me a message at</p>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-3">
    <span data-contact-email class="text-ink-strong font-mono text-[0.9375rem] break-all">
      simone.ferraro@nutek.it
    </span>

    {/*
     * The icon swaps with the word, and both are driven by one `data-copied`
     * attribute the script sets. Two SVGs toggled from CSS rather than from
     * JavaScript, because the stylesheet is already being downloaded and the
     * client budget is the thing worth spending carefully.
     */}
    <button
      data-contact-copy
      class="border-edge-strong hover:bg-ink hover:text-bg inline-flex shrink-0 cursor-pointer items-center gap-2 border px-4 py-2 font-mono text-[0.6875rem] tracking-[0.2em] uppercase transition-colors"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <g data-icon="idle">
          <path d="M5 2.6H3.7A1.2 1.2 0 0 0 2.5 3.8v7.5a1.2 1.2 0 0 0 1.2 1.2h6.6a1.2 1.2 0 0 0 1.2-1.2V3.8a1.2 1.2 0 0 0-1.2-1.2H9"></path>
          <rect x="5" y="1.5" width="4" height="2.3" rx="0.7"></rect>
        </g>
        <path data-icon="done" d="M3 7.3 5.8 10 11 3.8"></path>
      </svg>
      <span data-contact-copy-label>Copy</span>
    </button>
  </div>

  {/*
   * The copy result, for anyone who cannot see the button change. `role=status`
   * is polite by definition, so it is read after whatever is already speaking
   * rather than interrupting it.
   */}
  <p data-contact-status role="status" class="sr-only"></p>
</dialog>

<style>
  /*
   * Centring is not written here because the browser already does it: the UA
   * stylesheet gives an open modal `position: fixed`, `inset: 0` and auto
   * margins, which with the width set above is exactly the centred card. Saying
   * it again in author CSS only creates something to disagree with later. That
   * `position: fixed` is also what the close button is positioned against.
   *
   * The blur is the one thing the UA has no opinion on.
   */
  dialog[data-contact]::backdrop {
    backdrop-filter: blur(2px);
  }

  /* One attribute decides which of the two icons is drawn. */
  [data-icon="done"],
  [data-copied] [data-icon="idle"] {
    display: none;
  }

  [data-copied] [data-icon="done"] {
    display: inline;
  }
</style>

<script>
  /**
   * One listener on `document`, which is the object a ClientRouter swap does
   * not replace. So there is no `astro:page-load` rebinding here and no way for
   * this to quietly stop working on the second page a visitor opens, even
   * though the dialog element itself is re-rendered on every navigation. The
   * element is looked up when it is needed rather than held in a variable that
   * would go stale.
   */
  const RESET = 2000;
  let timer = 0;

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target?.closest) return;

    const dialog = document.querySelector<HTMLDialogElement>("dialog[data-contact]");
    if (!dialog) return;

    // A click that lands on the dialog itself landed on the backdrop: the card
    // and everything in it are children, so they never match.
    if (target === dialog) {
      dialog.close();
      return;
    }

    if (target.closest("[data-contact-open]")) {
      // The opener is a real mailto: link, and this is where it stops being one.
      event.preventDefault();
      dialog.showModal();
      return;
    }

    if (target.closest("[data-contact-close]")) {
      dialog.close();
      return;
    }

    const copy = target.closest<HTMLButtonElement>("[data-contact-copy]");
    if (!copy) return;

    const email = dialog.querySelector("[data-contact-email]")?.textContent?.trim() ?? "";
    const status = dialog.querySelector("[data-contact-status]");

    const label = copy.querySelector("[data-contact-copy-label]");

    const done = () => {
      clearTimeout(timer);
      copy.dataset.copied = "";
      if (label) label.textContent = "Copied";
      if (status) status.textContent = `${email} copied to the clipboard`;
      timer = window.setTimeout(() => {
        delete copy.dataset.copied;
        if (label) label.textContent = "Copy";
        if (status) status.textContent = "";
      }, RESET);
    };

    /*
     * The clipboard needs a secure context and a permission that can be
     * refused, and the address is on screen either way. So a failure selects
     * the text instead of reporting an error: the reader can copy it by hand,
     * which is what they were going to do before this button existed.
     */
    navigator.clipboard?.writeText(email).then(done, () => {
      const node = dialog.querySelector("[data-contact-email]");
      if (!node) return;
      const range = document.createRange();
      range.selectNodeContents(node);
      const selection = getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    });
  });
</script>

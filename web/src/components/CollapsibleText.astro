---
/**
 * Bio and label info, clamped with a fade until asked to open.
 *
 * The control only appears when the text actually overflows the clamp, which
 * cannot be known from the server: it depends on the rendered line count at
 * this viewport. So the height is measured after paint, and a short bio simply
 * renders as a paragraph with nothing to click.
 *
 * Unclamped in the markup, clamped by the script. That order is deliberate:
 * with no JavaScript the whole bio is readable, where clamping first would
 * leave a reader stuck at four lines with no way to open them.
 *
 * The opening and closing are animated and nothing else moves: the box changes
 * height, the page below follows it, and the scroll position is left alone. See
 * the click handler for why that last part is a decision rather than an
 * omission.
 */
---

<div class="max-w-[720px]" data-collapsible>
  <div class="relative overflow-hidden" data-clamp>
    <div data-inner><slot /></div>

    {/*
     * The `hidden` attribute, not the `hidden` class, and that is the whole of
     * this fix. The element carried both: the script toggles the attribute, and
     * the class sets `display: none` unconditionally, so the class won every
     * time and the gradient never appeared. Hidden here in the markup for the
     * same reason the button is, since with no JavaScript the text is never
     * clamped and there is nothing to fade out.
     */}
    <div
      class="pointer-events-none absolute right-0 bottom-0 left-0 h-12"
      style="background: linear-gradient(transparent, var(--color-bg))"
      hidden
      data-fade
    >
    </div>
  </div>

  {/*
   * `aria-expanded` because the changing label says the state to anyone reading
   * the words and nothing to anything reading the role. It starts false and is
   * written by `paint()` alongside the label, so the two cannot disagree.
   */}
  <button
    type="button"
    hidden
    aria-expanded="false"
    class="text-ink-muted hover:text-ink mt-8 inline-flex cursor-pointer items-center gap-[9px] font-mono text-xs tracking-[0.16em] uppercase"
    data-toggle
  >
    <span data-toggle-label>Read more</span>
    <span class="inline-flex transition-transform duration-200" data-chevron>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path
          d="M2 4l4 4 4-4"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
</div>

<script>
  /*
   * How much shows before the fade, in pixels rather than lines, because the
   * clamp is a max-height and the text it holds is not always one size.
   *
   * 145 against the bio's 27.2px line is 5.33 lines. Stopping part way through
   * a line is deliberate and the reason this is not a round number: a clamp
   * that lands on a clean line break reads as the end of the text, and the fade
   * then looks like decoration rather than a cut. It was 4.75 lines when body
   * copy was 19px, so a change to `--text-body` changes what this shows.
   */
  const CLAMP_PX = 145;

  function setUp(root: HTMLElement) {
    const clamp = root.querySelector<HTMLElement>("[data-clamp]");
    const inner = root.querySelector<HTMLElement>("[data-inner]");
    const fade = root.querySelector<HTMLElement>("[data-fade]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
    const label = root.querySelector<HTMLElement>("[data-toggle-label]");
    const chevron = root.querySelector<HTMLElement>("[data-chevron]");
    if (!clamp || !inner || !fade || !toggle || !label || !chevron) return;

    let open = false;
    let overflows = false;

    /** The resting state: no animation, no measuring, just the two heights. */
    const paint = () => {
      const clamped = overflows && !open;
      clamp.style.maxHeight = clamped ? `${CLAMP_PX}px` : "";
      fade.hidden = !clamped;
      toggle.hidden = !overflows;
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Collapse" : "Read more";
      chevron.style.transform = open ? "rotate(180deg)" : "";
    };

    const measure = () => {
      // Only meaningful while closed: once open the element is its full height
      // by definition, so re-measuring would always report no overflow.
      if (!open) overflows = inner.scrollHeight > CLAMP_PX + 1;
      paint();
    };

    /**
     * The script owns `max-height` in pixels for as long as the box is moving,
     * and `paint()` owns it again at rest.
     *
     * Pinning `from` before the animation exists is what makes opening animate.
     * Without it the element is left at its destination between the style write
     * and the animation's first frame, and where that destination is `none`, as
     * it is when opening, the box is already at full height when the frame is
     * painted: an open that snaps. Closing looked right through the same fault
     * only because there the destination is a number, and a frame showing it
     * early is a frame showing where the box was going anyway.
     *
     * `fill: "forwards"` then holds the last frame until `paint()` has put the
     * resting value back, so the box does not drop to `from` in the gap. The
     * fill is cancelled immediately after, since an animation left filling
     * would outrank the inline style for good and pin the box at that height.
     */
    const slide = (from: number, to: number) => {
      clamp.style.maxHeight = `${from}px`;

      /*
       * `ease-in-out` because the box is a panel opening, not an object
       * arriving. `ease-out` was leaving at full speed from a standing start,
       * which on a 779px bio threw most of the text past the reader in the
       * first 50ms and then crept the last few pixels — read side by side with
       * a jQuery `slideToggle`, whose `swing` is eased at both ends, it is the
       * difference between a panel and a flinch.
       */
      const animation = clamp.animate(
        { maxHeight: [`${from}px`, `${to}px`] },
        { duration: 300, easing: "ease-in-out", fill: "forwards" },
      );

      const settle = () => {
        paint();
        animation.cancel();
      };
      animation.finished.then(settle, settle);

      return animation;
    };

    /**
     * Collapsing moves the box and nothing else. The page is not scrolled.
     *
     * It used to be. The control was pinned to its place on screen and the page
     * scrolled under it, on the reasoning that a box shrinking by everything it
     * held would otherwise leave a reader somewhere down the collaborator list.
     * Measured on Eno's page, at a 779px collapse from a scroll position of
     * 600, that is not what it did: the pin ran the page up to scrollY 0 in
     * 180ms, hit the top of the document, ran out of room, and spent the
     * remaining 120ms letting the control slide after all. So the reader got a
     * lurch to the top of the page, and a collapse where the thing that was
     * moving changed halfway through.
     *
     * The fault is structural rather than a tuning problem: the bio sits near
     * the top of the document, so the scroll room above it is usually smaller
     * than the height it collapses by, and a hold that cannot be honoured is
     * worse than no hold. Every other disclosure on the web moves the content
     * below it, which is what a reader is expecting, and it is what the
     * accordion this was modelled on does. It never touches scrollY either.
     */
    toggle.addEventListener("click", () => {
      const from = clamp.getBoundingClientRect().height;

      open = !open;
      paint();
      const to = clamp.getBoundingClientRect().height;

      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) slide(from, to);
    });

    new ResizeObserver(measure).observe(inner);
    measure();
  }

  // Fires on the first load and again after every ClientRouter navigation.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-collapsible]").forEach(setUp);
  });
</script>

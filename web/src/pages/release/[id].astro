---
import Base from "@/layouts/Base.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import FieldRow from "@/components/FieldRow.astro";
import ListHeader from "@/components/ListHeader.astro";
import CreditRow from "@/components/CreditRow.astro";
import Absence from "@/components/Absence.astro";
import LoadMore from "@/components/LoadMore.astro";
import Tabs from "@/components/Tabs.astro";
import {
  getArtist,
  getArtistReleases,
  getFormats,
  getLabel,
  getLabelReleases,
  getRelease,
  getReleaseCredits,
} from "@/lib/queries";
import { creditLine } from "@/lib/roles";
import { PAGE_SIZE, artistLine, formatLine, pageSize, releasedOn } from "@/lib/view";

const release = getRelease(Number(Astro.params.id));
if (!release) return Astro.rewrite("/404");

const params = Astro.url.searchParams;
const limit = pageSize(params.get("show") ?? undefined);
const base = `/release/${release.id}`;

const credits = getReleaseCredits(release.id);
const shown = credits.slice(0, limit);
const line = artistLine(release.artists);

/* The same line as plain text, for the places markup cannot go. */
const by = line.map((a) => `${a.name}${a.separator}`).join("");
const format = formatLine(release.formats);
const date = releasedOn(release.released);

/*
 * Where "more from" goes: the first name on the line, and the first label.
 *
 * First rather than best, because the line is ordered by the record itself and
 * the first name is the one the headline shows. Both are skipped when the
 * corpus holds no page to pivot to, which for a credited name is the common
 * case rather than the exception.
 */
const lead = line[0] ?? null;
const artist = lead?.inCorpus ? getArtist(lead.id) : null;
const label = release.labels[0] ? getLabel(release.labels[0].id) : null;

/* Everything they have except this one, which is not more of anything. */
const MORE = 10;
const fromArtist = artist ? Math.max(artist.releaseCount - 1, 0) : 0;
const fromLabel = label ? Math.max(label.releaseCount - 1, 0) : 0;

const tabs = [
  ...(fromArtist > 0 ? [{ key: "artist", label: "More from artist", count: fromArtist }] : []),
  ...(fromLabel > 0 ? [{ key: "label", label: "More from label", count: fromLabel }] : []),
];
const asked = params.get("tab") ?? "";
const active = tabs.some((t) => t.key === asked) ? asked : (tabs[0]?.key ?? "");

const more =
  active === "artist" && artist
    ? getArtistReleases(artist.id, MORE, release.id)
    : active === "label" && label
      ? getLabelReleases(label.id, MORE, release.id)
      : [];

/* One query for the whole page of rows, since the sentence is written here. */
const formats = getFormats(more.map((r) => r.id));

const total = active === "artist" ? fromArtist : fromLabel;
const allHref =
  active === "artist" && artist
    ? `/artist/${artist.id}?tab=releases`
    : label
      ? `/label/${label.id}?tab=releases`
      : "";

/*
 * How this record got in, and it is deliberately not a grade.
 *
 * The five steps measure an artist's or a label's distance from the cluster,
 * which is a ratio over a body of work. One record has no body of work behind
 * it, so it carries no step and reads as a route instead — the same thing the
 * artist page says about someone the seed cannot measure.
 *
 * "Cluster" and not "scene", because these three flags are exactly what the
 * seed measures: its own styles, a credit reaching one of its artists, or a
 * label already inside it.
 */
const route = release.isSeed
  ? "here for its own styles, one of the records the dub techno cluster is measured on"
  : release.channelA && release.channelB
    ? "here because it credits an artist from the dub techno cluster, and came out on one of its labels"
    : release.channelA
      ? "here because it credits an artist from the dub techno cluster"
      : release.channelB
        ? "here because it came out on a label in the dub techno cluster"
        : "here as a neighbour of the dub techno cluster";

const count = credits.length;

const description = count
  ? `${release.title}${by ? ` by ${by}` : ""}${release.year ? `, ${release.year}` : ""} on Dub Digger: ${count.toLocaleString("en-GB")} credit${count === 1 ? "" : "s"}, from the Discogs credit dumps.`
  : `${release.title}${by ? ` by ${by}` : ""} is in this corpus, but no credits are recorded for it.`;

/*
 * MusicRelease rather than MusicAlbum: this is one pressing with a catalogue
 * number, which is the thing Discogs ids and the thing the page is about.
 * `creditedTo` takes the artist line as the record prints it, join phrases and
 * all, because that string is what the sleeve says and splitting it into
 * separate acts would assert a reading of "Presents" the dump does not make.
 */
const mainEntity = {
  "@type": "MusicRelease",
  name: release.title,
  url: `${Astro.site}release/${release.id}`,
  sameAs: `https://www.discogs.com/release/${release.id}`,
  ...(by ? { creditedTo: by } : {}),
  ...(release.released ? { datePublished: release.released } : {}),
  ...(release.labels[0] ? { recordLabel: release.labels[0].name } : {}),
  ...(release.labels[0]?.catno ? { catalogNumber: release.labels[0].catno } : {}),
  ...(format ? { musicReleaseFormat: format } : {}),
  ...(release.tracks.length ? { numTracks: release.tracks.length } : {}),
};
---

<Base
  title={`${release.title} — Dub Digger`}
  description={description}
  pageType="ItemPage"
  mainEntity={mainEntity}
  breadcrumbs={[{ name: release.title, href: base }]}
>
  <div class="column pt-16 pb-16 md:pt-24">
    <Eyebrow>Release</Eyebrow>

    {/*
     * Two lines, and the grey one is the record's own hierarchy: a sleeve says
     * who and then what. Only the first name goes up here, however many the
     * line has, because the headline is a name rather than a sentence and
     * "Mark Ernestus Presents Jeri-Jeri" above a long title is a paragraph in
     * 60px type. The whole line, join phrases and links, is the row below.
     *
     * It is inside the h1, so the page still has exactly one, and a screen
     * reader gets "Substance, Rise And Shine" the way the design reads it.
     */}
    <h1 class="text-name-label text-ink-strong mt-6 leading-[0.9] font-bold tracking-[-0.045em]">
      {lead && <span class="text-ink-dim block">{lead.name}</span>}
      {release.title}
    </h1>

    <dl class="mt-10 max-w-[760px]">
      <FieldRow label={line.length > 1 ? "Artists" : "Artist"}>
        {
          line.length === 0 ? (
            <span class="text-ink-faint">None recorded</span>
          ) : (
            line.map((a) => (
              <>
                {/*
                 * Closed up on purpose: `compressHTML` is off, so a newline
                 * between these two renders as a space, and 41,335 join phrases
                 * are a comma. The name sits tight inside its own anchor for
                 * the same reason, or `link-rule` underlines a trailing space.
                 */}
                {a.inCorpus ? (
                  <a href={`/artist/${a.id}`} class="link-rule">{a.name}</a>
                ) : (
                  <span class="text-ink-dim">{a.name}</span>
                )}{a.separator}
              </>
            ))
          )
        }
      </FieldRow>

      <FieldRow label={release.labels.length > 1 ? "Labels" : "Label"}>
        {
          release.labels.length === 0 ? (
            /*
             * Never a reason, because the corpus cannot tell them apart: every
             * label id on a corpus release has a page, so an empty list means
             * the dump named no label at all or named the "Not On Label"
             * placeholder, which is filtered at ingest.
             */
            <span class="text-ink-faint">None recorded</span>
          ) : (
            <span class="flex flex-wrap gap-x-4 gap-y-1">
              {release.labels.map((l) => (
                <span>
                  <a href={`/label/${l.id}`} class="link-rule">{l.name}</a>
                  {l.catno && <span class="text-ink-faint"> – {l.catno}</span>}
                </span>
              ))}
            </span>
          )
        }
      </FieldRow>

      {/*
       * Format and country are shown only when the dump has them. A row reading
       * "—" would be the page reporting an absence it has no opinion about:
       * unlike a missing credit, a missing carrier says nothing about the
       * record, only about the entry.
       */}
      {format && <FieldRow label="Format">{format}</FieldRow>}
      {release.country && <FieldRow label="Country">{release.country}</FieldRow>}

      <FieldRow label="Released">
        {date ?? <span class="text-ink-faint">Not recorded</span>}
      </FieldRow>

      <FieldRow label="In corpus" last={release.tracks.length === 0}>
        <span class="text-ink-faint">{route}</span>
      </FieldRow>

      {
        release.tracks.length > 0 && (
          <FieldRow label="Tracklist" last>
            {/*
             * Titles and positions, and no cap. It is the contents of the
             * record, so stopping early would be answering a question nobody
             * asked — the same reason a credit row shows all of its roles.
             *
             * A track is not an entity and nothing here is a link: the dump's
             * track-level artists are dropped at parse time, so there is
             * nobody to pivot to and the interface must not imply there is.
             */}
            <ul class="space-y-[6px]">
              {release.tracks.map((t) => (
                <li class="grid grid-cols-[2.5rem_1fr] gap-x-3">
                  <span class="text-ink-faint">{t.position}</span>
                  <span>{t.title}</span>
                </li>
              ))}
            </ul>
          </FieldRow>
        )
      }
    </dl>

    {/*
     * The one link that leaves, as a button rather than a row.
     *
     * Its siblings carry a "View on" row because an artist or a label lists
     * sites of its own; a release has none, so the row would be a label in
     * front of a single link. Pure id substitution, no licensing exposure.
     */}
    <a
      href={`https://www.discogs.com/release/${release.id}`}
      target="_blank"
      rel="noreferrer"
      class="border-edge-strong hover:bg-ink hover:text-bg mt-12 inline-block border px-8 py-[15px] font-mono text-xs tracking-[0.2em] uppercase transition-colors"
    >
      View on Discogs<span class="sr-only"> (opens in a new tab)</span>
      <span class="text-ink-faint ml-3" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="column pt-14">
    {/*
     * Credits get a band of their own above the tabs, rather than a tab beside
     * them. They are what the record is: the two lists below are where to go
     * next, and a page that hid its own credits behind a tab would be filing
     * the answer with the follow-up questions.
     */}
    <div class="border-hairline flex items-baseline gap-3 border-b pb-3">
      <h2 class="mono-label text-ink text-[0.8125rem]">Credits</h2>
      <span class="text-ink-faint font-mono text-[0.6875rem] tracking-[0.2em]">
        {count.toLocaleString("en-GB")}
      </span>
    </div>

    {
      shown.length === 0 ? (
        /*
         * 443,005 of 1,095,302 releases carry no credits at all, so this is the
         * page for two in five of them and it has to be honest about which
         * absence it is. It cannot say "worked alone": a record with one name on
         * the line and nobody in the credits is either a solo record or a record
         * nobody has finished entering, and the dump does not say which.
         */
        <Absence>
          No credits recorded. The corpus holds{" "}
          {line.length > 0 ? "the artist line above" : "the title above"} and nothing else for this
          release, which is the case for two in five records in it.
        </Absence>
      ) : (
        <ul>
          {shown.map((c) => (
            <CreditRow
              href={c.inCorpus ? `/artist/${c.id}` : undefined}
              name={c.name}
              detail={creditLine(c.roles)}
            />
          ))}
        </ul>
      )
    }

    {
      limit < count && (
        <LoadMore href={`${base}?show=${limit + PAGE_SIZE}`} remaining={count - limit} />
      )
    }
  </div>

  {
    tabs.length > 0 && (
      <div class="column pt-14 pb-20 md:pb-32">
        <Tabs tabs={tabs} active={active} basePath={base} />

        {/*
         * Year in the middle column and format in the wide one, which is the
         * sketch's two right-hand columns the other way round. The format is
         * the long value — "2× Vinyl, 12\", 45 RPM" — and the 10rem column is
         * the only one that holds it; the 6rem one is built for a number.
         */}
        <ListHeader name="Release" count="Year" meta="Format" />
        <ul>
          {more.map((r) => (
            <CreditRow
              count={r.year ?? "—"}
              href={`/release/${r.id}`}
              name={r.title}
              meta={formatLine(formats.get(r.id) ?? [])}
              metaLabel="Format"
            />
          ))}
        </ul>

        {/*
         * Ten rows, then the whole discography one click away. This list is a
         * way on rather than a second copy of the artist page, and paging it
         * here would fight the credits list above for the same `show`.
         */}
        {total > MORE && (
          <LoadMore href={allHref} remaining={total} label="See all" hold={false} />
        )}
      </div>
    )
  }
</Base>

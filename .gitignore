node_modules/
.DS_Store
*.log

# Discogs dumps and everything derived from them.
# These are large, regenerable artifacts — never commit them.
ingest/data/dumps/
ingest/data/samples/
ingest/data/artifacts/
ingest/data/*.sqlite
ingest/data/*.sqlite-journal
ingest/data/*.sqlite-wal
ingest/data/*.sqlite-shm

# The derived database the web app reads (copied in from ingest), and the
# write-ahead log sidecars SQLite creates beside it while the app is running.
web/data/*.sqlite
web/data/*.sqlite-wal
web/data/*.sqlite-shm

# Astro. The root .astro/ appears when a command is run from the repo root
# rather than from web/; it is the same generated types directory either way.
web/dist/
web/.astro/
.astro/
*.tsbuildinfo

# Local machine settings. The shared .claude/settings.json is committed.
.claude/settings.local.json

.env
.env.local

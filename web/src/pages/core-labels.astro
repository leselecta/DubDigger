---
import Base from "@/layouts/Base.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ListHeader from "@/components/ListHeader.astro";
import CreditRow from "@/components/CreditRow.astro";
import Absence from "@/components/Absence.astro";
import LoadMore from "@/components/LoadMore.astro";
import SortBy from "@/components/SortBy.astro";
import { getTopLabels, TOP_LIST_SIZE } from "@/lib/queries";
import { PAGE_SIZE, SHOW_SORT, pageSize, years } from "@/lib/view";

const params = Astro.url.searchParams;
const limit = pageSize(params.get("show") ?? undefined);
const sort = params.get("sort") === "name" ? "name" : "ranking";

/*
 * Sorted after the ranking, never instead of it: the list is the top
 * TOP_LIST_SIZE by scene weight, and A–Z reorders that same set rather than
 * reaching alphabetically into the whole corpus.
 */
const labels = getTopLabels();
const ordered =
  sort === "name" ? [...labels].sort((a, b) => a.name.localeCompare(b.name)) : labels;
const shown = ordered.slice(0, limit);
---

<Base
  title="Core Labels — Dub Digger"
  description="The labels the dub techno scene records for, ranked by how much of their roster sits inside it. Part curation, part data, and openly experimental."
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Core Labels", href: "/core-labels" }]}
>
  <div class="column pt-16 pb-16 md:pt-24">
    <Eyebrow>The labels the scene records for</Eyebrow>
    <h1 class="text-name text-ink-strong mt-6 leading-[0.92] font-bold tracking-[-0.04em]">
      The Core Labels<span class="text-accent">.</span>
    </h1>

    <p class="text-lead text-ink-muted mt-10 max-w-[760px]">
      Unlike a search, this list is a mix of curation and data. It's an experimental feature, so
      expect to find errors and inconsistencies.
    </p>
  </div>

  <div class="column pb-20 md:pb-32">
    {
      labels.length === 0 ? (
        <Absence>No labels recorded. Nothing has been ingested yet.</Absence>
      ) : (
        <>
          {SHOW_SORT && <SortBy basePath="/core-labels" active={sort} />}
          <ListHeader name="Label" count="Releases" meta="Active" />
          <ul>
            {shown.map((label) => (
              <CreditRow
                count={label.releaseCount.toLocaleString("en-GB")}
                href={`/label/${label.id}`}
                name={label.name}
                meta={years(label.firstYear, label.lastYear)}
                metaLabel="Active"
              />
            ))}
          </ul>
        </>
      )
    }

    {
      limit < labels.length && (
        <LoadMore
          href={`/core-labels?sort=${sort}&show=${limit + PAGE_SIZE}`}
          remaining={labels.length - limit}
        />
      )
    }

    {
      limit >= labels.length &&
        labels.length === TOP_LIST_SIZE && (
          /*
           * The list is capped, and a page that simply stops looks like the end
           * of the data rather than the end of the page. Search reaches the
           * rest.
           */
          <p class="text-ink-faint mt-10 font-mono text-xs tracking-[0.14em] uppercase">
            The top {TOP_LIST_SIZE.toLocaleString("en-GB")}. More labels are in the corpus, reachable
            by search.
          </p>
        )
    }
  </div>
</Base>

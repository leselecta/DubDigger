---
/** A `[label | value]` row in the identity block, separated by hairlines. */
interface Props {
  label: string;
  accent?: boolean;
  /**
   * The last row in the block, which closes it with a hairline underneath.
   *
   * A prop rather than a wrapping `<div>` at the call site, which is where this
   * started: a `<dl>` may hold a `<div>` grouping a `dt` and a `dd`, and that is
   * exactly the `<div>` this component already is — so wrapping it put a second
   * one in between and the grouping stopped being one the parser recognises.
   */
  last?: boolean;
}

const { label, accent = false, last = false } = Astro.props;
---

<div
  class:list={[
    "border-hairline grid grid-cols-[7rem_1fr] gap-x-6 border-t py-2 font-mono text-[0.8125rem] sm:grid-cols-[180px_1fr]",
    last && "border-b",
  ]}
>
  <dt class="text-ink-faint tracking-[0.12em] uppercase">{label}</dt>
  <dd class={accent ? "text-accent" : "text-ink"}><slot /></dd>
</div>

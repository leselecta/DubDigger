---
import { suggest } from "@/lib/queries";
import { GRADE_SHADE, gradeWord } from "@/lib/view";

/**
 * The rows under the search box, rendered by the server.
 *
 * A partial rather than a JSON endpoint, which is the same "prefer the server"
 * rule the rest of the site runs on, one step further in: the client script
 * fetches this and assigns it, so the markup, the classes and the escaping stay
 * here in an .astro file instead of being rebuilt as strings in the browser.
 * It is what keeps the new script to the size it is.
 *
 * The listbox itself lives in `SearchField`, so the ARIA relationship between
 * the input and the list is static markup that exists before any of this
 * arrives, and this is only ever its contents. The tab row is static there for
 * a second reason: a `listbox` may hold options and nothing else, so a control
 * cannot sit inside one.
 *
 * All three tabs come back on one fetch, and only one of them is shown. The
 * pools have to run anyway to know which tabs have anything behind them, so the
 * other two are already costed by the time this renders, and sending them makes
 * a tab switch free. A control read at a glance should not wait on a request.
 *
 * Nothing found returns nothing, and the dropdown stays shut. A shortcut that
 * has nowhere to jump to is not an answer, and the answer for a miss is a real
 * one that this cannot fit: the results page says the corpus is a slice centred
 * on dub techno and that a legitimate absence is the boundary working. Enter
 * still goes there.
 */
export const partial = true;

const q = Astro.url.searchParams.get("q") ?? "";
const groups = suggest(q);

/*
 * Artists and labels first, and it is the default because it is the question
 * this tool exists to answer. A record is a thing you find on the way to a
 * name: `space` returns three Orb records before The Orb, and `chain re` puts
 * Diana Ross above the label the scene is built on. Ranking cannot fix that on
 * its own, since a record really is a good answer to `rodent` — so the fix is
 * to ask which question first, and let the reader say otherwise in one key.
 *
 * `all` last rather than first, which is the same call the tab order on an
 * artist page makes: the specific answers come before the merged one.
 */
const tabs = [
  { key: "names", hits: groups.names },
  { key: "releases", hits: groups.releases },
  { key: "all", hits: groups.all },
];

/** The tab the panel opens on, falling through when the preferred one is empty. */
const opens = tabs.find((t) => t.hits.length > 0)?.key ?? "";
const any = opens !== "";

/*
 * Cached at the edge of nothing in particular, but honestly: the database is a
 * static artifact that only changes when it is republished and the server is
 * restarted, so a repeated prefix is a repeated answer. Five minutes is enough
 * to cover a person typing, backspacing and typing again without asking a
 * one-core VPS to rank the same prefix twice.
 *
 * `noindex` because this is a fragment, not a page. robots.txt already
 * disallows anything carrying a query string, and this says the same thing to
 * anything that arrives without reading it.
 */
Astro.response.headers.set("Cache-Control", "public, max-age=300");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

{
  tabs.map((tab) => (
    <div data-suggest-group={tab.key} hidden={tab.key !== opens}>
      {tab.hits.map((hit) => (
        <a
          role="option"
          aria-selected="false"
          href={`/${hit.kind}/${hit.id}`}
          data-suggest-option
          class="group/opt border-hairline-soft text-left data-[active=true]:bg-accent data-[active=true]:text-bg grid cursor-pointer grid-cols-[1fr_auto] items-baseline gap-x-3 border-b px-4 py-2.5 last:border-b-0"
        >
          <span class="truncate text-[0.9375rem] font-bold tracking-[-0.01em]">{hit.name}</span>

          {/*
           * What the row is, and then what stands behind it.
           *
           * The kind is the half this list cannot do without: Chain Reaction is
           * a label and two unrelated artists, and it is what a shortlist under
           * a half-typed word is being asked. So it never folds.
           *
           * What follows it is the grade on a name and the maker on a record,
           * which is the same job done with the only material each kind has. A
           * grade measures a body of work against the cluster and one pressing
           * is not a body of work, so a record has none and is not given a
           * borrowed one: the lead artist's word would be a claim about a
           * person printed in a row about a record.
           */}
          <span class="text-ink-faint group-data-[active=true]/opt:text-bg font-mono text-[0.6875rem] tracking-[0.1em] whitespace-nowrap uppercase group-data-[active=true]/opt:opacity-70">
            {hit.kind}

            {hit.artist && (
              <span class="inline-block max-w-[9rem] truncate align-bottom md:max-w-[14rem]">
                {" · "}
                {hit.artist}
              </span>
            )}

            {/*
             * The grade the results page used to show, in the same five words
             * and the same shade, back because the tab it sits on holds only the
             * two kinds that have one. It went at the root on 2026-09-08 rather
             * than by patch, and this is not that patch returning: what was
             * wrong was a column that could answer for two kinds out of three,
             * and a tab that holds no records has no third kind to fail.
             *
             * In the same cell as the kind rather than a column of its own,
             * which is what keeps a record's row from leaving a hole where a
             * grade would be. The kind is the half that never folds, since
             * "which of these" is what a shortlist under a half-typed word is
             * being asked and Chain Reaction is a label and a record and an act.
             *
             * The grade folds away below `md`, where the field is a phone's
             * width and the name is what a thumb is aiming at. `sr-only` rather
             * than `hidden`, so the option is still read out with its grade: the
             * row is one control and cannot say in a heading what its columns
             * are. It takes the separator with it, since a line ending in a
             * dangling middot is the row saying something was cut.
             */}
            {hit.relevance && (
              <span
                class:list={[
                  "sr-only md:not-sr-only md:whitespace-nowrap",
                  "group-data-[active=true]/opt:text-bg group-data-[active=true]/opt:opacity-70",
                  GRADE_SHADE[gradeWord(hit.relevance)],
                ]}
              >
                {" · "}
                {gradeWord(hit.relevance)}
              </span>
            )}
          </span>
        </a>
      ))}
    </div>
  ))
}

{
  /*
   * The way out of the shortlist, and the only row that is not a name.
   *
   * Four rows is a glance, not an answer, so the list has always ended one
   * keystroke from the full results without ever saying so: Enter on the box
   * goes there, and nobody who reached for the arrow keys was told. This is
   * that keystroke written down.
   *
   * It is a real option in the listbox rather than a footer under it, so
   * arrowing past the last name lands on it and Enter follows it, and the
   * script needs no line for any of that. Only rendered when there are names
   * above it: a miss still returns nothing and the dropdown still stays shut,
   * because "view all" of nothing is the shortlist offering to show its own
   * emptiness at greater length.
   *
   * It is outside the three groups and carries no tab, because the results page
   * has none. The tabs are the shortlist deciding which question to answer in
   * four rows; a page built for forty answers both at once and does not need to
   * be told which one the dropdown was on.
   *
   * The chevron is the tab row's, at the size the tab row draws it. One arrow
   * on the site, pointing the one direction it ever points.
   *
   * It wears the accent as a ground rather than as a grey row of type, which
   * is the one place on the site a link is louder than the names above it.
   * That is what it is for: the four names are the answer if one of them is
   * the answer, and this is the offer if none of them is, so it has to be
   * visible without being read. The accent's own rule allows it, since a
   * ground marks the thing being reached for and nothing on the site is more
   * literally that.
   *
   * Which means the highlight had to move. A row that is already accent cannot
   * say "the arrows are on me" by turning accent, so it inverts to the ink
   * ground that "Load more" and the nav cells take on hover: same vocabulary,
   * one step louder still, and the two states cannot be mistaken for each
   * other. Hover takes it too, because a pointer is reaching for the same
   * thing the arrows are.
   */
  any && (
    <a
      role="option"
      aria-selected="false"
      href={`/?q=${encodeURIComponent(q)}`}
      data-suggest-option
      data-suggest-out
      class="bg-accent text-bg hover:bg-ink hover:text-bg data-[active=true]:bg-ink data-[active=true]:text-bg flex cursor-pointer items-center justify-between gap-3 px-4 py-3 transition-colors"
    >
      <span class="font-mono text-[0.6875rem] font-medium tracking-[0.1em] uppercase">
        View all results
      </span>

      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path
          d="M4 2l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  )
}

---
import Base from "@/layouts/Base.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ListHeader from "@/components/ListHeader.astro";
import CreditRow from "@/components/CreditRow.astro";
import Absence from "@/components/Absence.astro";
import LoadMore from "@/components/LoadMore.astro";
import SortBy from "@/components/SortBy.astro";
import { getTopArtists, TOP_LIST_SIZE } from "@/lib/queries";
import { PAGE_SIZE, SHOW_SORT, pageSize, years } from "@/lib/view";

const params = Astro.url.searchParams;
const limit = pageSize(params.get("show") ?? undefined);
const sort = params.get("sort") === "name" ? "name" : "ranking";

/*
 * Sorted after the ranking, never instead of it: the list is the top
 * TOP_LIST_SIZE by scene weight, and A–Z reorders that same set rather than
 * reaching alphabetically into the whole corpus.
 */
const artists = getTopArtists();
const ordered =
  sort === "name" ? [...artists].sort((a, b) => a.name.localeCompare(b.name)) : artists;
const shown = ordered.slice(0, limit);
---

<Base
  title="Core Artists — Dub Digger"
  description="The artists closest to the dub techno scene, ranked by how much of their work sits inside it. Part curation, part data, and openly experimental."
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Core Artists", href: "/core-artists" }]}
>
  <div class="column pt-16 pb-16 md:pt-24">
    <Eyebrow>The artists closest to the scene</Eyebrow>
    <h1 class="text-name text-ink-strong mt-6 leading-[0.92] font-bold tracking-[-0.04em]">
      The Core Artists<span class="text-accent">.</span>
    </h1>

    <p class="text-lead text-ink-muted mt-10 max-w-[760px]">
      Unlike a search, this list is a mix of curation and data. It's an experimental feature, so
      expect to find errors and inconsistencies.
    </p>
  </div>

  <div class="column pb-20 md:pb-32">
    {
      artists.length === 0 ? (
        <Absence>No artists graded. Nothing has been ingested yet.</Absence>
      ) : (
        <>
          {SHOW_SORT && <SortBy basePath="/core-artists" active={sort} />}
          <ListHeader name="Artist" count="In scene" meta="Active" />
          <ul>
            {shown.map((artist) => (
              <CreditRow
                count={artist.sceneReleases.toLocaleString("en-GB")}
                href={`/artist/${artist.id}`}
                name={artist.name}
                meta={years(artist.firstYear, artist.lastYear)}
                metaLabel="Active"
              />
            ))}
          </ul>
        </>
      )
    }

    {
      limit < artists.length && (
        <LoadMore
          href={`/core-artists?sort=${sort}&show=${limit + PAGE_SIZE}`}
          remaining={artists.length - limit}
        />
      )
    }

    {
      limit >= artists.length &&
        artists.length === TOP_LIST_SIZE && (
          <p class="text-ink-faint mt-10 font-mono text-xs tracking-[0.14em] uppercase">
            The top {TOP_LIST_SIZE.toLocaleString("en-GB")}. More artists are in the corpus,
            reachable by search.
          </p>
        )
    }
  </div>
</Base>

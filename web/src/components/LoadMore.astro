---
/**
 * Ghost button that reveals the next page of a list, again via the URL.
 *
 * `data-hold-scroll` because the longer list is the same list with rows added
 * to the end: the reader is already looking at the right place, and a swapped
 * document opening at the top throws that away.
 *
 * It also carries the release page's "all releases" link, which is the same
 * button doing the opposite job: that one leaves for another page, so it says
 * so with its own label and asks for the scroll NOT to be held. Holding it
 * there would land the reader halfway down a page they have not seen.
 */
interface Props {
  href: string;
  remaining: number;
  label?: string;
  /** False when the link goes somewhere else rather than lengthening this list. */
  hold?: boolean;
}

const { href, remaining, label = "Load more", hold = true } = Astro.props;
---

<a
  href={href}
  data-hold-scroll={hold ? "" : undefined}
  class="border-edge-strong hover:bg-ink hover:text-bg mt-10 inline-block border px-8 py-[15px] font-mono text-xs tracking-[0.2em] uppercase transition-colors"
>
  {label}
  <span class="text-ink-faint ml-3">{remaining.toLocaleString("en-GB")}</span>
</a>

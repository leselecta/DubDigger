---
import Base from "@/layouts/Base.astro";
import SearchField from "@/components/SearchField.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import LabelledBand from "@/components/LabelledBand.astro";
import { getCorpusStats, getDbPath } from "@/lib/db";
import Tabs from "@/components/Tabs.astro";
import { search } from "@/lib/queries";
import type { SearchKind } from "@/lib/queries";
import LoadMore from "@/components/LoadMore.astro";
import { GRADE_SHADE, gradeWord, PAGE_SIZE, pageSize } from "@/lib/view";

const q = Astro.url.searchParams.get("q") ?? undefined;
const stats = getCorpusStats();

/*
 * The same three tabs as the dropdown, on the same three slices of the same
 * ranking. The dropdown asks which question first in four rows; this asks it
 * in forty, and the two have to agree or the shortcut lands somewhere other
 * than where it was pointing.
 *
 * Which tab a query opens on depends on what is behind them: `names` unless it
 * is empty, which is the dropdown's fallback rule and is settled inside
 * `search` because it needs the counts and the counts need the ranking. So a
 * title nobody recorded an artist for still answers on arrival, rather than
 * showing a reader an empty Artists & Labels and leaving them to find the tab
 * that has it.
 *
 * `?tab=` in the URL, like every other tab on the site: a link, a real address,
 * and no state the server cannot answer for.
 */
const asked = Astro.url.searchParams.get("tab") ?? "";
const wanted =
  asked === "names" || asked === "releases" || asked === "all" ? asked : ("auto" as const);

/*
 * The same `?show=` the tab lists use, so the results page pages the way every
 * other list on the site does: a link, a real address, and the hold script
 * keeping the reader where they were when the longer list swaps in.
 *
 * A tab link carries no `show`, which is what resets the page length when you
 * switch: forty of the next question rather than two hundred of it.
 */
const limit = pageSize(Astro.url.searchParams.get("show") ?? undefined);

const results = q ? search(q, limit, wanted) : null;

const kind: SearchKind = results?.kind ?? "names";

const TAB_LABELS: Record<SearchKind, string> = {
  names: "Artists & Labels",
  releases: "Releases",
  all: "All",
};

/*
 * Every tab is drawn, including an empty one, which is the opposite of the
 * dropdown's rule and right for the opposite reason. Four rows read at a glance
 * cannot spend one on a tab that is a way in to nothing; a table has a count
 * beside each word, so an empty tab says "0" and answers the question rather
 * than raising it. Hiding it here would leave a reader wondering whether the
 * page had looked.
 */
const tabs = results
  ? (["names", "releases", "all"] as const).map((key) => ({
      key,
      label: TAB_LABELS[key],
      count: results.counts[key],
    }))
  : [];

/*
 * A query, and something to answer it with. The second half is what keeps the
 * page from having no `<h1>` at all: with no database the results block is
 * never rendered, so the heading that stands in for the headline is not there
 * either, and dropping the headline as well left the page with none.
 */
const searching = Boolean(q) && stats !== null;

const columns: [string, number][] = stats
  ? [
      ["Artists", stats.artists],
      ["Labels", stats.labels],
      ["Releases", stats.releases],
    ]
  : [];

/** The column widths, shared by the header row and every result, so they line up. */
const RESULT_GRID = "grid-cols-[1fr_4.5rem] md:grid-cols-[1fr_5.5rem_11rem_5rem]";

/**
 * The relevance column is back, and a record inherits its grade.
 *
 * It carried the grade in five words, and the argument for it was that breadth
 * is only an asset when a distant act looks distant: Mozart is genuinely in
 * this corpus, on 85 releases that really do credit someone here, and saying so
 * is honest where hiding him would not be.
 *
 * It came out on 2026-09-08, when records became searchable and a third of the
 * rows had nothing to show, and the objection recorded then was that the lead
 * artist's grade would put a word about a person in a row about a record.
 * **What put it back on 2026-09-09 is that the ranking was already doing
 * exactly that.** `rankHits` halves a record's weight by the lead artist's
 * grade and always has, so the order was built on the inherited word and the
 * column was the one part of the page not saying so. Showing it is the page
 * agreeing with its own sort rather than making a new claim, and the artist's
 * name is already on the line below the title, so the word sits beside the name
 * it describes.
 *
 * Measured: 97.1% of release rows across 50 queries have an artist grade to
 * inherit. The rest are compilations, every one, and they take the label's
 * grade instead — a `Various` record has no single maker, which is a fact about
 * the record rather than a hole in the data, and the room it came out on is the
 * next honest thing to ask. Simone took the label fallback on 2026-09-09 with
 * the objection on the table: one column now answers from two places, which is
 * a second provenance in the one column on the site where the word already
 * stands alone. `gradedOn` carries which, so the wording can own it.
 */

const rows = (results?.hits ?? []).map((hit) => ({ hit, grade: gradeWord(hit.relevance) }));
---

{/*
 * The one page that had no description of its own, and that is how the footer
 * became its snippet. Every other page passes one; this one fell back to the
 * layout's default, which opened with the headline verbatim. The default is
 * fixed too, but the home page states its own for the same reason the rest do:
 * a fallback is what a page gets when nobody decided, and this is the page a
 * search result is most likely to be.
 *
 * It states what the tool is, in one clause, and stops. "Dig the Extended
 * Scene" is the headline's job and is already on screen, so the description
 * does not repeat it. An earlier version opened with the move instead ("Type an
 * artist, see who they worked with..."), which read as an instruction to
 * somebody who had not yet decided whether to click.
 */}
<Base
  search={searching}
  query={q}
  description="A map of the dub techno scene and its neighbours, built from Discogs credit data."
>
  {/*
   * Searching drops the tagline and keeps everything else. A headline
   * announcing what the site is has done its job by the time someone has
   * typed into it, and the results are what they came back for.
   *
   * On a phone the band is sized to a figures cell's `py-10`, so the headline
   * reads as one block in a stack of blocks rather than as a hero with air
   * around it. The top is 16 rather than 10 because the two edges are not built
   * the same: below the tagline the 40px is followed by the 24px the figures
   * wrapper holds above its own hairline, so 40 and 40 comes out visibly
   * lopsided. 64 against 40 is what reads as equal. The desktop values are the
   * design's and are left alone: there the band is the whole first screen and
   * the air is the point.
   */}
  <div
    class:list={
      searching
        ? "column pt-16 pb-16 md:pt-24"
        : "column pt-16 pb-10 text-center md:pt-[130px] md:pb-24"
    }
  >
    {/*
     * Two pages share this file, and once there is a query it stops being the
     * home page. The hero field goes with the headline it belonged to: the box
     * is why the home page exists, and on an answer it is a thing you reach for
     * while reading something else, which is what the header field already is
     * everywhere else on the site. Keeping both would be the page asking twice
     * for the same thing, which is the rule `search={false}` was written for,
     * read the other way round.
     *
     * So the results page takes the shape every other page has: left-aligned in
     * the column, an eyebrow, and a title naming what you are looking at. The
     * count moves under it and stops being the `<h1>`, which is a change to a
     * decision recorded in CLAUDE.md — the count was the heading because the
     * page had no other, and now it has one. Still exactly one `<h1>`, which is
     * the half of that rule the footer's WCAG claim rests on.
     *
     * No accent stop after "results", though `/info` has one after its title.
     * The miss heading below spends the accent on this page, and a stop would
     * be competing with it in the one case it has to be read.
     */}
    <Eyebrow>{searching ? "Search" : "The Dub Techno Index"}</Eyebrow>

    {
      searching ? (
        <h1 class="text-name text-ink-strong mt-6 leading-[0.92] font-bold tracking-[-0.04em]">
          Search results
        </h1>
      ) : (
        <>
          <h1 class="text-hero text-ink-strong mt-3 leading-[0.92] font-bold tracking-[-0.04em] md:mt-9">
            Dig the Extended Scene<span class="text-accent">.</span>
            <br />
            Dub Techno First<span class="text-accent">.</span>
          </h1>

          <div class="mx-auto mt-16 max-w-[640px]">
            <SearchField size="hero" value={q} />
          </div>
          <p class="mt-[18px] font-mono text-xs tracking-[0.14em] text-ink-faint uppercase">
            Search artists · labels · releases
          </p>
        </>
      )
    }
  </div>

  {
    stats === null ? (
      /*
       * An empty result that looks like an answer is worse than an honest "no
       * data". That principle starts here: before any ingest has run, say so
       * plainly rather than rendering a search box that silently returns nothing.
       */
      <div class="column pb-20 md:pb-32">
        <div class="border-hairline max-w-[720px] border-t pt-10">
          <h2 class="mono-label">No database yet</h2>
          <p class="text-body text-ink-muted mt-4">
            Nothing has been ingested. The app expects a precomputed SQLite file at:
          </p>
          <p class="text-ink-faint mt-4 font-mono text-xs break-all">{getDbPath()}</p>
          <p class="text-body text-ink-muted mt-4">
            Run the ingest steps in <span class="font-mono text-sm">ingest/</span>, then publish the
            result into <span class="font-mono text-sm">web/data/</span>.
          </p>
        </div>
      </div>
    ) : (
      <>
        {searching && results && (
          <div class="column pb-20 md:pb-24">
            {/*
             * The count, which used to be this page's `<h1>` and is not any
             * more. It was the heading because the page had no other: the
             * headline belonged to the home page and went once someone typed,
             * and dropping the count as well left the document with no `<h1>`
             * on it at all. The page has a title of its own now, so the count
             * goes back to being what it always read as, the line saying what
             * you are looking at under the thing you are looking at. Same
             * classes, so nothing moves, and still exactly one `<h1>`.
             *
             * A miss takes the accent, a hit does not. It is the one line here
             * that has to be read rather than counted past: the answer is that
             * there is no answer, and the paragraph under it is the part that
             * matters. The headline's two accent stops are not on the page once
             * someone has typed, and the title above deliberately took no stop
             * of its own, so this still spends colour that came free.
             *
             * The phone rule above it went with the hero. It was drawing the
             * line between a search field and its answer, in the one place they
             * were a single column of text; the field is in the header now and
             * there is a title between them, so the boundary is drawn by the
             * page rather than by a hairline.
             */}
            <p
              class:list={["mono-label mb-6", results.counts.all === 0 && "text-accent"]}
            >
              {/*
               * The count is the tab's, not the page's, now that the page can
               * be lengthened: "Closest 40" was true of a list that stopped
               * there and is not true of one with a button under it.
               *
               * "Closest" survives for the case it was written for. The pools
               * are 200 a kind, so a broad query fills them and the number
               * stops being a total; saying "200 found" there would state the
               * cap as if it were a count, which is the one thing this heading
               * has always refused to do.
               */}
              {results.counts.all === 0
                ? `Nothing found for “${q}”`
                : results.counts[kind] === 0
                  ? `No ${kind === "releases" ? "releases" : "artists or labels"} for “${q}”`
                  : results.capped[kind]
                    ? `Closest ${results.counts[kind].toLocaleString("en-GB")} for “${q}”`
                    : `${results.counts[kind].toLocaleString("en-GB")} found for “${q}”`}
            </p>

            {/*
             * The tab row, under the count and above the columns, because the
             * count is what the page is and the tabs are how it is cut. Every
             * tab is drawn even at zero: a reader who clicks Releases and finds
             * none has been answered, and the row is how they get back.
             *
             * `basePath` carries the query, which is why `Tabs` works out its
             * own separator. `?tab=` and nothing else, so a tab is a real
             * address that can be linked, shared and gone back to, and the
             * dropdown's way out can point straight at one.
             */}
            {results.counts.all > 0 && (
              <Tabs tabs={tabs} active={kind} basePath={`/?q=${encodeURIComponent(q!)}`} />
            )}

            {/*
             * The paragraph takes no top padding: the heading's own `mb-6` is
             * the gap, which is the same 1.5rem a LabelledBand puts between a
             * mono label and the prose beside it. A `py-10` here stacked a
             * second gap on top of that and floated the sentence away from the
             * label it belongs to.
             */}
            {results.counts.all > 0 && results.counts[kind] === 0 ? (
              /*
               * An empty tab is not a miss, and the two must not read alike.
               * The corpus paragraph says a name is legitimately absent from a
               * slice centred on dub techno, which would be false here: the
               * query was answered, on another tab, and the row above says by
               * how many. So this is one line and no argument.
               */
              <p class="text-body text-ink-muted max-w-[720px] pb-10">
                Nothing under this heading, but the other tabs above have{" "}
                {results.counts.all.toLocaleString("en-GB")}.
              </p>
            ) : results.counts.all === 0 ? (
              <p class="text-body text-ink-muted max-w-[720px] pb-10">
                This corpus is a slice centred on dub techno, not all of Discogs, so plenty of real
                artists and labels are legitimately absent. That is the boundary working, not a gap.
                Or this may mean that the entry doesn't actually exist on Discogs.
              </p>
            ) : (
              <>
                <div
                  class:list={[
                    "border-hairline text-ink-faint grid gap-x-[22px] border-b pb-3 font-mono text-[0.6875rem] tracking-[0.2em] uppercase",
                    RESULT_GRID,
                  ]}
                >
                  <span>Name</span>
                  <span>Releases</span>
                  <span class="hidden md:block">Relevance</span>
                  <span class="hidden md:block">Type</span>
                </div>

                <ul>
                  {rows.map(({ hit, grade }) => (
                    <li
                      class:list={[
                        "border-hairline-soft grid items-baseline gap-x-[22px] border-b py-[18px]",
                        RESULT_GRID,
                      ]}
                    >
                      <a
                        href={`/${hit.kind}/${hit.id}`}
                        class="link-rule text-row min-w-0 justify-self-start font-bold tracking-[-0.01em]"
                      >
                        {hit.name}
                      </a>

                      {/*
                       * Records only, and the row is unusable without it:
                       * "Biokinetics" matches 15 pressings and "Phylyps Trak"
                       * ten, so a column of bare titles would be the search
                       * answering the same question fifteen times.
                       */}
                      {hit.detail && (
                        <span class="text-ink-faint col-start-1 mt-1 font-mono text-xs tracking-[0.05em]">
                          {hit.detail}
                        </span>
                      )}

                      {/*
                       * "N/A" on a record rather than a number or a gap. The
                       * column counts a body of work and a pressing is one
                       * thing, so a "1" would be a figure invented to fill the
                       * cell; a blank leaves the reader to work out whether the
                       * count is zero, missing, or not asked for. The words say
                       * which, and they are what a reader scanning a column
                       * expects a cell with no answer to say.
                       */}
                      <span class="text-ink-faint font-mono text-[0.8125rem] font-medium tabular-nums md:row-start-1 md:col-start-2">
                        {hit.releaseCount === null ? "N/A" : hit.releaseCount.toLocaleString("en-GB")}
                      </span>

                      {/*
                       * Both of these fold under the name below `md`, where the
                       * header above has no column left to name them from. So
                       * they carry their own heading down with them and read
                       * "Relevance: medium", "Type: label" on a phone. The
                       * label stays `text-ink-faint` in each, under the value's
                       * own colour, so the grade's shade is still the thing the
                       * eye lands on.
                       *
                       * `mt-2` because the grid has no row gap and the name
                       * above carries `link-rule`, so the underline's bottom
                       * and this line's top were the same y. A short name hides
                       * that: the rule is only as wide as the word. A name that
                       * wraps fills the column, and then a full-width rule sits
                       * flat on "Relevance:" with nothing between them. Only
                       * the first of the two moves; the pair stays tight,
                       * because they are two lines of one block.
                       *
                       * `md:sr-only` rather than `md:hidden`, which is the
                       * whole difference between a label that stops being drawn
                       * and one that stops existing. Above `md` the heading is
                       * back in its column, so nothing should show it twice —
                       * but `display: none` also takes it out of the accessible
                       * tree, and the header row is a sibling `<div>` with no
                       * way to say which column it names. A row read aloud came
                       * out "Basic Channel, 47, high, artist". Out of flow and
                       * still spoken, every value keeps the word for what it is.
                       */}
                      {/*
                       * The grade, and on a record the grade it inherits.
                       *
                       * A name answers for itself. A record has no body of work
                       * to measure, so it takes its lead artist's word — which
                       * is not a new claim, because `rankHits` has always halved
                       * a record's weight by exactly that figure. The order was
                       * already built on it. What changed is the column saying
                       * so, and the artist's name is on the line above, so the
                       * word sits beside the name it belongs to.
                       *
                       * A compilation takes its label's instead: `Various` is a
                       * record with no single maker rather than a missing one,
                       * and the room it came out on is the next honest thing to
                       * ask. Both are the same five steps, which is what lets
                       * one column hold them; `gradedOn` is what a wording can
                       * use to say which answered, and nothing reads it yet.
                       */}
                      <span
                        class:list={[
                          "col-start-1 mt-2 font-mono text-xs tracking-[0.1em] uppercase md:row-start-1 md:col-start-3 md:mt-0",
                          GRADE_SHADE[grade],
                        ]}
                      >
                        <span class="text-ink-faint md:sr-only">Relevance:</span>
                        {grade}
                      </span>

                      <span class="text-ink col-start-1 font-mono text-xs tracking-[0.1em] uppercase md:row-start-1 md:col-start-4 md:mt-0">
                        <span class="text-ink-faint md:sr-only">Type:</span>
                        {hit.kind}
                      </span>
                    </li>
                  ))}
                </ul>

                {/*
                 * `show` carries the tab with it, so lengthening a list cannot
                 * quietly drop you back onto the one the page would have opened
                 * by itself. A tab link carries no `show` for the mirror of the
                 * same reason: switching question starts at forty again.
                 */}
                {results.truncated && (
                  <LoadMore
                    href={`/?q=${encodeURIComponent(q!)}&tab=${kind}&show=${limit + PAGE_SIZE}`}
                    remaining={results.counts[kind] - limit}
                  />
                )}
              </>
            )}
          </div>
        )}

        {/*
         * The bottom padding is the band's when there is one and the figures'
         * when there is not: the prose block carries its own air below, so
         * stacking the page's full bottom padding under it as well left the
         * sentence marooned above the footer.
         */}
        <div
          class:list={[
            "column pt-6",
            searching ? "pb-20 md:pb-32" : "pb-10 md:pb-16",
          ]}
        >
          <dl class="border-hairline grid border-t sm:grid-cols-3" data-figures>
            {columns.map(([label, value], i) => (
              <div
                class:list={[
                  "px-0 py-10 sm:px-10 sm:py-14",
                  i < columns.length - 1 && "border-hairline border-b sm:border-r sm:border-b-0",
                ]}
              >
                <dt class="mono-label">{label}</dt>
                <dd
                  class="text-stat text-ink-strong mt-3 font-bold tracking-[-0.03em] tabular-nums"
                  data-count={value}
                >
                  {value.toLocaleString("en-GB")}
                </dd>
              </div>
            ))}
          </dl>

          {/*
           * The one piece of prose in `<main>`, and it is here for a reason the
           * rest of the page cannot serve. An AI Overview answers a branded
           * question by quoting rendered body text and citing the URL it came
           * from; a meta description is a request an engine may honour on a
           * result card and is never a passage candidate, and neither is the
           * JSON-LD. So `/` was not losing that comparison to `/info`, it was
           * never in it: an eyebrow, a headline, a field, a caption and three
           * figures hold no sentence to quote.
           *
           * It opens with the name and says what the tool is, which is the
           * shape retrieved for "what is dub digger". Deliberately NOT the
           * wording of `/info`'s lead: two URLs offering one identical passage
           * makes them compete, and `/info` has four bands of depth behind the
           * same claim. Same answer, its own sentences.
           *
           * Below the figures, left-aligned, in the band the other prose pages
           * use. The first screen is the design and stays untouched, which was
           * the standing decision this had to fit inside rather than reverse;
           * position on the page is not what makes a passage retrievable, being
           * real body text in `<main>` is.
           *
           * Hidden while searching, like the headline above: a results page is
           * the answer and nothing else, and this would otherwise sit under
           * every `?q=` address as well.
           */}
          {/*
           * The band's top gap matches the one above the figures: the hero
           * band's `pb-10 md:pb-24` plus this wrapper's `pt-6`. Both hairlines
           * then sit the same distance below the block above them, so the
           * bottom of the page reads as two bands of one rhythm rather than one
           * band with a paragraph tacked under it.
           */}
          {!searching && (
            <div class="mt-16 md:mt-30">
              <LabelledBand label="What this is">
                <p class="text-body text-ink-muted max-w-[760px]">
                  Dub Digger is a map of the dub techno scene and its neighbours, drawn from Discogs
                  credit data. Type an artist, and you see who they worked with and which labels
                  they released on. Then click any of them and keep digging.
                </p>
              </LabelledBand>
            </div>
          )}
        </div>
      </>
    )
  }

  <script>
    /**
     * The three figures count up the first time they come into view.
     *
     * The size of this corpus is the claim the bottom of the page makes, and a
     * number that arrives rather than sits there is what makes half a million
     * releases read as half a million. It is the one thing on the page whose
     * trigger the server cannot know: whether the band has been scrolled to.
     *
     * The real figures are rendered by the server and only handed to the script
     * once it is going to animate them. So no JavaScript, and a reader who has
     * asked for less motion, both get the true number with nothing to notice.
     */
    const DURATION = 1400;

    function countUp(figures: HTMLElement[]) {
      const start = performance.now();

      const step = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        const eased = 1 - (1 - t) ** 3;

        for (const figure of figures) {
          const target = Number(figure.dataset.count);
          figure.textContent = Math.round(target * eased).toLocaleString("en-GB");
        }

        if (t < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    }

    // Fires on the first load and again after every ClientRouter navigation.
    document.addEventListener("astro:page-load", () => {
      const band = document.querySelector<HTMLElement>("[data-figures]");
      if (!band || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const figures = [...band.querySelectorAll<HTMLElement>("[data-count]")];
      if (figures.length === 0) return;

      for (const figure of figures) figure.textContent = "0";

      /*
       * All three run together, off the band rather than off each figure: they
       * are one statement in three parts, and staggering them would read as
       * three separate arrivals. The negative bottom margin holds the start
       * until the band is properly on screen instead of peeking at the edge.
       */
      const seen = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          seen.disconnect();
          countUp(figures);
        },
        { rootMargin: "0px 0px -12% 0px" },
      );

      seen.observe(band);
    });
  </script>
</Base>

---
/**
 * Ghost button that reveals the next page of a list, again via the URL.
 *
 * `data-hold-scroll` because the longer list is the same list with rows added
 * to the end: the reader is already looking at the right place, and a swapped
 * document opening at the top throws that away.
 */
interface Props {
  href: string;
  remaining: number;
}

const { href, remaining } = Astro.props;
---

<a
  href={href}
  data-hold-scroll
  class="border-edge-strong hover:bg-ink hover:text-bg mt-10 inline-block border px-8 py-[15px] font-mono text-xs tracking-[0.2em] uppercase transition-colors"
>
  Load more
  <span class="text-ink-faint ml-3">{remaining.toLocaleString("en-GB")}</span>
</a>

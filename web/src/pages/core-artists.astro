---
import Base from "@/layouts/Base.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ListHeader from "@/components/ListHeader.astro";
import CreditRow from "@/components/CreditRow.astro";
import Absence from "@/components/Absence.astro";
import LoadMore from "@/components/LoadMore.astro";
import SortBy from "@/components/SortBy.astro";
import { getTopArtists, TOP_LIST_SIZE } from "@/lib/queries";
import { PAGE_SIZE, listHref, listSort, pageSize, sortList, years } from "@/lib/view";

const params = Astro.url.searchParams;
const limit = pageSize(params.get("show") ?? undefined);
const sort = listSort(params.get("sort"));

/*
 * Sorted after the ranking, never instead of it: the list is the top
 * TOP_LIST_SIZE by scene weight, and A–Z reorders that same set rather than
 * reaching alphabetically into the whole corpus.
 */
const artists = getTopArtists();
const shown = sortList(artists, sort).slice(0, limit);
---

<Base
  title="Core Artists — Dub Digger"
  description="The artists closest to the dub techno scene, ranked by how much of their work sits inside it. Part curation and part data, drawn from Discogs credits."
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Core Artists", href: "/core-artists" }]}
>
  <div class="column pt-16 pb-16 md:pt-24">
    <Eyebrow>The artists closest to the scene</Eyebrow>
    <h1 class="text-name text-ink-strong mt-6 leading-[0.92] font-bold tracking-[-0.04em]">
      The Core Artists<span class="text-accent">.</span>
    </h1>

    <p class="text-lead text-ink-muted mt-10 max-w-[760px]">
      Unlike a search, this list is a mix of curation and data. A few names are here because I
      consider them relevant, others because nobody would argue with them. The rest are ranked by
      how much of their work sits inside the core set of dub techno artists and labels I picked out
      of Discogs. It's an experimental feature, so expect to find errors and inconsistencies.
    </p>
  </div>

  <div class="column pb-20 md:pb-32">
    {
      artists.length === 0 ? (
        <Absence>No artists graded. Nothing has been ingested yet.</Absence>
      ) : (
        <>
          <SortBy basePath="/core-artists" active={sort} />
          {/*
           * "Releases", and it counts every release on their artist line.
           *
           * It was "Releases in scene" over `sceneReleases` until 2026-08-25,
           * which is the number the list actually ranks on, and it was parked
           * for not saying plainly enough what it counted. The heading is now
           * the plain word, so the column carries the plain number: `releaseCount`
           * off the coverage row, which is the same total the artist's own page
           * prints under the same word. Not `sceneReleases`, which would read 58
           * here against 171 there for Rhythm & Sound, and not `lineReleases`
           * either, which counts artist lines only and would read 160.
           *
           * The cost is that the list ranks on a figure it does not show. That
           * is the right way round: a column has to be true on its own before it
           * has to be useful, and the ranking is explained in prose above.
           */}
          <ListHeader name="Artist" count="Releases" meta="Active" />
          <ul>
            {shown.map((artist) => (
              <CreditRow
                count={artist.releaseCount.toLocaleString("en-GB")}
                href={`/artist/${artist.id}`}
                name={artist.name}
                meta={years(artist.firstYear, artist.lastYear)}
                metaLabel="Active"
              />
            ))}
          </ul>
        </>
      )
    }

    {
      limit < artists.length && (
        <LoadMore
          href={listHref("/core-artists", sort, limit + PAGE_SIZE)}
          remaining={artists.length - limit}
        />
      )
    }

    {
      limit >= artists.length &&
        artists.length === TOP_LIST_SIZE && (
          <p class="text-ink-faint mt-10 font-mono text-xs tracking-[0.14em] uppercase">
            The top {TOP_LIST_SIZE.toLocaleString("en-GB")}. More artists are in the corpus,
            reachable by search.
          </p>
        )
    }
  </div>
</Base>

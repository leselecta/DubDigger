---
/**
 * The small accented line above a headline. On the home page it names the site,
 * on an entity page it names what you are looking at, which is the one thing
 * the big name itself cannot tell you: "Chain Reaction" is both a label and two
 * unrelated artists.
 *
 * 0.8125rem rather than 0.75, to match the `LabelledBand` heading. The two are
 * the only mono type on the site that heads something rather than captioning
 * it, so they read at one size: an eyebrow naming the page and a band label
 * naming a section are the same job at two altitudes.
 *
 * On a phone it steps down to 0.6875rem. At 0.32em of tracking the full size
 * eats most of a narrow viewport and starts competing with the name below it,
 * which is the one thing an eyebrow must not do.
 */

/**
 * The mark before the word, on the three entity pages only.
 *
 * User testing found readers could not always say what kind of page they were
 * on at a glance, and the eyebrow was already the answer in words. A shape is
 * read before a word is, so this is the same answer arriving sooner. The pages
 * that are not entities keep the bare word: a mark is an identifier, and "Info"
 * identifies nothing.
 *
 * It is deliberately not a rebus. The word is right beside it, so the mark does
 * not have to be decoded, only told apart from the other two, which is why they
 * are drawn for silhouette rather than for detail: a round holed thing, a
 * person, an angular tag. The tag is the everyday sense of the word rather than
 * the music one, and it wins anyway, because every other candidate for a label
 * was a circle or a box and both were already taken.
 *
 * 14px in a 12px box, and a 1.35 stroke where the rest of the site's SVGs use
 * 1.5: at 12px the marks read as dots against 13px caps, and at 1.5 the tag's
 * hole and the disc's centre close up.
 */
const MARKS = {
  artist: '<circle cx="6" cy="3.9" r="2.05"/><path d="M1.9 10.6c0-2.4 1.85-3.9 4.1-3.9s4.1 1.5 4.1 3.9"/>',
  label: '<path d="M6.4 1.1h4.5v4.5l-5.3 5.3-4.5-4.5z"/><circle cx="8.75" cy="3.25" r=".85"/>',
  release: '<circle cx="6" cy="6" r="4.7"/><circle cx="6" cy="6" r=".85"/>',
};

interface Props {
  icon?: keyof typeof MARKS;
}

const { icon } = Astro.props;
---

{/*
 * `inline-flex` rather than `flex`, so the line is still only as wide as its
 * own text. As a block it would stretch the full column and the gap between
 * mark and word would be the only thing anyone could see moving.
 */}
<p
  class="text-accent inline-flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.32em] uppercase md:text-[0.8125rem]"
>
  {
    icon && (
      <svg
        width="14"
        height="14"
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.35"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={MARKS[icon]}
      />
    )
  }
  <slot />
</p>

---
/** A full-width band with a mono section label down the left. */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

{/*
 * `md:mt-1` puts the label's caps on the same line as the first line of the
 * text beside it. Both boxes already start at the top of the row, but the type
 * inside them does not: the label is 12px with the browser's own leading, while
 * body copy is 17px at 1.6, and that leading is split above and below every
 * line. So the prose starts about 4px lower than the label does, and the row
 * reads as though the heading has floated up.
 *
 * Only from md, because below it the grid is one column and the label sits on
 * its own line, where there is nothing to align it to.
 */}
<div class="border-hairline grid gap-6 border-t py-14 md:grid-cols-[180px_1fr]">
  <h2 class="mono-label md:mt-1">{label}</h2>
  <div><slot /></div>
</div>

---
import Base from "@/layouts/Base.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import FieldRow from "@/components/FieldRow.astro";
import LabelledBand from "@/components/LabelledBand.astro";
import ListHeader from "@/components/ListHeader.astro";
import CreditRow from "@/components/CreditRow.astro";
import Chip from "@/components/Chip.astro";
import Absence from "@/components/Absence.astro";
import Tabs from "@/components/Tabs.astro";
import LoadMore from "@/components/LoadMore.astro";
import ProfileText from "@/components/ProfileText.astro";
import OutboundLinks from "@/components/OutboundLinks.astro";
import CollapsibleText from "@/components/CollapsibleText.astro";
import {
  getArtist,
  getCollaborators,
  getArtistLabels,
  getProfileNames,
  getRelations,
  getArtistReleases,
  type Relation,
} from "@/lib/queries";
import { creditLine } from "@/lib/roles";
import { countLine } from "@/lib/seo";
import { PAGE_SIZE, pageSize, years } from "@/lib/view";

const artist = getArtist(Number(Astro.params.id));
if (!artist) return Astro.rewrite("/404");

const params = Astro.url.searchParams;
const limit = pageSize(params.get("show") ?? undefined);
const relations = getRelations(artist.id);
const base = `/artist/${artist.id}`;

const tabs = [
  { key: "collaborators", label: "Collaborators", count: artist.collaboratorCount },
  { key: "labels", label: "Labels", count: artist.labelCount },
  { key: "releases", label: "Releases", count: artist.releaseCount },
];
const asked = params.get("tab") ?? "collaborators";
const active = tabs.some((t) => t.key === asked) ? asked : "collaborators";
const total = tabs.find((t) => t.key === active)!.count;

const groups: [string, Relation["kind"]][] = [
  ["Also known as", "alias"],
  ["Members", "member"],
  ["Member of", "group"],
];

const collaborators = active === "collaborators" ? getCollaborators(artist.id, limit) : [];
const labels = active === "labels" ? getArtistLabels(artist.id).slice(0, limit) : [];
const releases = active === "releases" ? getArtistReleases(artist.id, limit) : [];

/**
 * One grade, and what it is standing on.
 *
 * The five steps are the ones the search results use. Two different things can
 * put an artist on a step, so the clause always says which: work inside the
 * cluster, or membership of a tradition it came out of. King Tubby reads
 * medium, and it would be a lie to let that imply dub techno records he never
 * made, so the clause says weak ties AND says why he is here anyway.
 *
 * The ladder had a gap in it before the fifth step arrived, and that is why
 * this table barely moved: it ran very strong, strong, weak, very weak, with
 * nothing in the middle. "Moderate" is the rung that was always missing, so the
 * new step took the word at the top and everything else stayed where it was.
 *
 * "Cluster" rather than "scene" throughout: the scene is the whole extended
 * map this tool draws, and the cluster is the dub techno core it was drawn
 * from. Ties are measured against the core, so the core is what they name.
 *
 * The bottom step carries the route instead, because an artist with no seed
 * work is not a weak version of core, they are a neighbour, and a label mate is
 * not a weak collaborator. That distinction is too useful to drop.
 */
const SCENE_REASON: Record<string, string> = {
  "very high": "very strong ties with the core dub techno cluster",
  high: "strong ties with the core dub techno cluster",
  medium: "moderate ties with the core dub techno cluster",
  low: "weak ties with the core dub techno cluster",
  none: "very weak ties with the core dub techno cluster",
};

/**
 * What each tradition claims, in its own words.
 *
 * These are not the same claim and must not read as though they were. Roots dub
 * and Detroit are descent, and the phrasing says so. Afrobeat and uk jazz are
 * kinship: editorial choices about what this map should hold, not because
 * anyone traces dub techno back to Lagos or to Peckham. Acid jazz and DNB is
 * inheritance at one remove, which is why it is the one tradition that lifts to
 * low rather than to medium.
 *
 * Dubstep and uk garage is the only one that points forward. It cannot say
 * "grew out of" in either direction, since it came after this scene rather than
 * before it, so it says what the two actually have in common instead.
 */
const LINEAGE_REASON: Record<string, string> = {
  "roots dub": "the Jamaican tradition dub techno grew out of",
  reggae: "the tradition dub itself came out of",
  "detroit techno": "the tradition Berlin was answering",
  afrobeat: "a tradition this scene keeps company with",
  "uk jazz": "the scene around Gilles Peterson and Brownswood",
  "acid jazz and DNB": "UK scenes with Jamaican roots of their own",
  "dubstep and uk garage": "the UK scene that inherited dub the generation after",
};

const lifted = artist.lineage !== null && artist.relevance !== artist.sceneRelevance;
const grade = artist.relevance === "none" ? "Very low" : artist.relevance;

/**
 * What this page holds, for the description a search result shows.
 *
 * Built from the tab counts, so it is specific to the artist rather than a
 * template with a name dropped into it, and it drops what the corpus does not
 * have. When it has nothing at all the sentence says so, for the same reason
 * the page itself does: an empty answer dressed as a positive one is worse
 * than a plain "nothing recorded".
 */
const held = countLine([
  [artist.collaboratorCount, "collaborator"],
  [artist.labelCount, "label"],
  [artist.releaseCount, "release"],
]);

const description = held
  ? `${artist.name} on Dub Digger: ${held}, from the Discogs credit dumps.`
  : `${artist.name} is in this corpus, but no credits are recorded for them in it.`;

/*
 * MusicGroup rather than Person, and it is a trade-off worth naming. Discogs
 * artist ids are held by solo musicians, bands, aliases and projects alike, and
 * MusicGroup is the one schema.org type that covers all four; Person would
 * assert an individual, which for this corpus is wrong more often. It is still
 * wrong for the mastering engineers and sleeve designers who hold artist ids,
 * and there is no field in the dump that would tell them apart.
 */
const mainEntity = {
  "@type": "MusicGroup",
  name: artist.name,
  url: `${Astro.site}artist/${artist.id}`,
  sameAs: `https://www.discogs.com/artist/${artist.id}`,
};

const route =
  artist.channelA && artist.channelB
    ? "an occasional collaborator and label mate"
    : artist.channelA
      ? "an occasional collaborator"
      : artist.channelB
        ? "an occasional label mate"
        : "an occasional collaborator or label mate";
---

<Base
  title={`${artist.name} — Dub Digger`}
  description={description}
  pageType="ProfilePage"
  mainEntity={mainEntity}
  breadcrumbs={[{ name: artist.name, href: base }]}
>
  <div class="column pt-16 pb-16 md:pt-24">
    <Eyebrow>Artist</Eyebrow>
    <h1 class="text-name text-ink-strong mt-6 leading-[0.92] font-bold tracking-[-0.04em]">
      {artist.name}
    </h1>

    {/*
     * Three counts and nothing else. The seed tally that used to close this line
     * ("2 in the dub techno cluster, 100% of output") is the working of the
     * grade rather than a fact about the artist, and the Relevance row below
     * already says what it comes to in words. Nothing is lost: it is the same
     * measurement, read out once instead of twice.
     */}
    <p class="text-accent mt-10 font-mono text-[0.8125rem] tracking-[0.06em] uppercase">
      {artist.releaseCount.toLocaleString("en-GB")} releases <span class="text-ink-strong"
        >&nbsp;·&nbsp;</span
      > {artist.collaboratorCount.toLocaleString("en-GB")} collaborators <span
        class="text-ink-strong">&nbsp;·&nbsp;</span
      > {artist.labelCount.toLocaleString("en-GB")} labels
    </p>

    <dl class="mt-9 max-w-[760px]">
      {
        artist.realName && artist.realName !== artist.name && (
          <FieldRow label="Real name">{artist.realName}</FieldRow>
        )
      }
      <FieldRow label="Date active">{years(artist.firstYear, artist.lastYear) || "—"}</FieldRow>
      <FieldRow label="Relevance" accent={artist.relevance !== "none"}>
        {
          lifted ? (
            <>
              <span class="capitalize">{grade}</span>
              <span class="text-ink-faint">
                , {SCENE_REASON[artist.sceneRelevance]}, here for lineage: {artist.lineage},{" "}
                {LINEAGE_REASON[artist.lineage!]}
              </span>
            </>
          ) : artist.relevance !== "none" ? (
            <>
              <span class="capitalize">{grade}</span>
              <span class="text-ink-faint">
                , {SCENE_REASON[artist.relevance]}
                {artist.lineage && `, and part of the ${artist.lineage} tradition`}
              </span>
            </>
          ) : (
            <>
              Very low
              <span class="text-ink-faint">
                , {SCENE_REASON.none} (here as {route})
              </span>
            </>
          )
        }
      </FieldRow>
      <FieldRow label="View on" last>
        <OutboundLinks kind="artist" id={artist.id} urls={artist.urls} />
      </FieldRow>
    </dl>
  </div>

  <div class="column">
    {
      artist.profile && (
        <LabelledBand label="Bio">
          <CollapsibleText>
            <div class="text-body text-ink-muted">
              <ProfileText text={artist.profile} names={getProfileNames(artist.profile)} />
            </div>
          </CollapsibleText>
        </LabelledBand>
      )
    }

    {
      groups.map(([label, kind]) => {
        const of = relations.filter((r) => r.kind === kind);
        if (of.length === 0) return null;
        return (
          <LabelledBand label={label}>
            <div class="flex max-w-[760px] flex-wrap gap-x-3 gap-y-[10px]">
              {of.map((r) => (
                <Chip
                  href={r.inCorpus ? `/artist/${r.id}` : undefined}
                  name={r.name}
                  count={r.releaseCount}
                />
              ))}
            </div>
          </LabelledBand>
        );
      })
    }
  </div>

  <div class="column pt-14 pb-20 md:pb-32">
    <Tabs tabs={tabs} active={active} basePath={base} />

    {
      active === "collaborators" &&
        (collaborators.length === 0 ? (
          /*
           * "Nobody has entered the credits" and "they worked alone" are
           * different answers, and an empty list that looks like an answer is
           * worse than an honest absence. The coverage flags tell them apart.
           */
          artist.releaseCount === 0 ? (
            <Absence>No releases in this corpus.</Absence>
          ) : artist.creditedReleases === 0 ? (
            <Absence>
              No credits recorded. Nobody has entered credits for any of these{" "}
              {artist.releaseCount.toLocaleString("en-GB")} releases, so this is missing data rather
              than solo work.
            </Absence>
          ) : (
            <Absence>
              Worked alone. Credits exist on {artist.creditedReleases.toLocaleString("en-GB")} of{" "}
              {artist.releaseCount.toLocaleString("en-GB")} releases and name no one else.
            </Absence>
          )
        ) : (
          <>
            {/*
             * The unit stays in the heading because the figure is a count of
             * records, not of partnerships: Rhett Davies and Eno are 335 here,
             * which "Collaborations" would read as 335 separate team-ups rather
             * than one long working relationship. Plain "Releases" cannot be
             * used, since the same column on the Labels tab means that artist's
             * releases on that label and the two would read as one figure.
             * "Shared" was tried and never said shared what.
             */}
            <ListHeader name="Name" count="Releases together" />
            <ul>
              {collaborators.map((c) => (
                <CreditRow
                  count={c.sharedReleases}
                  href={`/artist/${c.id}`}
                  name={c.name}
                  detail={creditLine(c.roles)}
                />
              ))}
            </ul>
          </>
        ))
    }

    {
      active === "labels" &&
        (labels.length === 0 ? (
          <Absence>No labels recorded.</Absence>
        ) : (
          <>
            <ListHeader name="Label" count="Releases" meta="Active" />
            <ul>
              {labels.map((l) => (
                <CreditRow
                  count={l.releaseCount}
                  href={`/label/${l.id}`}
                  name={l.name}
                  meta={years(l.firstYear, l.lastYear)}
                  metaLabel="Active"
                />
              ))}
            </ul>
          </>
        ))
    }

    {
      active === "releases" &&
        (releases.length === 0 ? (
          <Absence>No releases in this corpus.</Absence>
        ) : (
          <>
            <ListHeader name="Release" count="Year" meta="Label" />
            <ul>
              {releases.map((r) => (
                <CreditRow
                  count={r.year ?? "—"}
                  href={`https://www.discogs.com/release/${r.id}`}
                  name={r.title}
                  external
                  detail={creditLine(r.roles)}
                  meta={r.label}
                  metaLabel="Label"
                >
                  {/*
                   * The release title leaves for Discogs, so without this the
                   * only outbound link on the row is one that ends the dig. The
                   * label is the pivot that keeps it going.
                   */}
                  {r.labelId && (
                    <a slot="meta" href={`/label/${r.labelId}`} class="link-rule">
                      {r.label}
                    </a>
                  )}
                </CreditRow>
              ))}
            </ul>
          </>
        ))
    }

    {
      limit < total && (
        <LoadMore href={`${base}?tab=${active}&show=${limit + PAGE_SIZE}`} remaining={total - limit} />
      )
    }
  </div>
</Base>

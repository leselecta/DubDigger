---
import { ClientRouter } from "astro:transitions";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ContactDialog from "@/components/ContactDialog.astro";
import { canonicalPath } from "@/lib/seo";
import "@/styles/globals.css";

/**
 * The shell every page sits in.
 *
 * ClientRouter is here for one reason: this tool is a map you hop around, and
 * the whole premise is that a pivot costs one click. Swapping the document
 * instead of reloading it keeps that feeling, and keeps the scroll position on
 * a tab change. It is the one piece of framework JavaScript the site ships on
 * every page, and it earns it.
 */
interface Props {
  title?: string;
  description?: string;
  /** The schema.org type of this page. A hub is a CollectionPage, a person or a label a ProfilePage. */
  pageType?: string;
  /** For a profile page, the thing the page is about. Folded into the graph as its subject. */
  mainEntity?: Record<string, unknown>;
  /** The trail to here, Home excluded: it is always the first step and is added below. */
  breadcrumbs?: { name: string; href: string }[];
  /** Keep it out of the index. For pages that are an answer to a bad address, not a page. */
  noindex?: boolean;
  /**
   * Show the header's search field. The home page carries its own in the hero,
   * so it is the one page that asks for this off rather than asking twice for
   * the same thing.
   */
  search?: boolean;
}

const {
  title = "Dub Digger — the dub techno index",
  /*
   * A fallback, and it deliberately does not open with the headline any more.
   * It used to be "Dig the Extended Scene. Dub Techno First." followed by one
   * clause, which is the h1 verbatim plus a fragment: a description that only
   * repeats the heading above it is the case where an engine throws it away and
   * writes its own from whatever prose the page has. On the home page the only
   * prose was the footer, so the footer is what Google published.
   */
  description = "A map of the dub techno scene and its neighbours, built from Discogs credit data: who worked with whom, and the labels they released on.",
  pageType = "WebPage",
  mainEntity,
  breadcrumbs = [],
  noindex = false,
  search = true,
} = Astro.props;

/*
 * Every absolute URL on the page comes from Astro.site, which is asserted in
 * astro.config.mjs. The path is stripped of its query first: the tabs and the
 * sort control are one page answering the same question in a different order,
 * and each of them nominating itself would enter the index several times over.
 */
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const card = new URL("/og.jpg", Astro.site).href;

/*
 * One graph, and it claims only what can be shown.
 *
 * There is a WebSite node and a node for this page, cross-referenced by @id so
 * an engine reads them as one thing rather than as two documents that happen to
 * share a domain.
 *
 * `creator` sits on the WebSite and nowhere else, and the split is the point:
 * the tool is mine, the data is not. A page about an artist is generated from
 * credits typed in by Discogs contributors, so an `author` on the page node
 * would take thousands of people's work and put one name on it. The footer says
 * the same thing in words, and this is only that sentence in markup.
 *
 * Still no Organization and no publisher, for the original reason: there is no
 * company here, and filling a recommended field with an invented one would
 * assert something the pages do not.
 *
 * The SearchAction is the one behaviour worth declaring, because it is real: the
 * home page takes a `q` and answers with results.
 */
const site = new URL("/", Astro.site).href;

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${site}#website`,
    url: site,
    name: "Dub Digger",
    description:
      "A map of scenes drawn from Discogs credit data, centred on dub techno: who worked with whom, and the labels they released on.",
    inLanguage: "en",
    creator: {
      "@type": "Person",
      name: "Simone Ferraro",
      url: "https://simoneferraro.co.uk",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: `${site}?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@type": pageType,
    "@id": `${canonical}#page`,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": `${site}#website` },
    ...(mainEntity ? { mainEntity } : {}),
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumbs`,
    itemListElement: [{ name: "Home", href: "/" }, ...breadcrumbs].map((step, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: step.name,
      item: new URL(step.href, Astro.site).href,
    })),
  });
}

/*
 * `<` is escaped because an artist name is contributor-entered text going into
 * a script element, where the parser ends the block at the first `</script>`
 * whatever the JSON around it says. JSON.stringify does not do this for you.
 */
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
     * What a shared link renders as. One card for the whole site rather than one
     * per page: it is a made asset in the site's own design, not a picture of
     * anything, so there is nothing per-page for it to say that the title and
     * description beside it are not already saying.
     */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dub Digger" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={card} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    {/*
     * The first thing in the document, and invisible until it is reached.
     *
     * Every page opens with a wordmark, a search field and four nav cells
     * before the headline, and a keyboard reader had no way past them. It
     * targets `#content`, which is the `<main>` each page opens after its
     * header — the header itself is rendered by the page rather than by this
     * layout, so the landmark cannot be drawn here.
     *
     * `focus:` rather than `focus-visible:`: it is `sr-only` at rest, so the
     * only way to reach it is the keyboard, and there is nothing to guard
     * against. The accent ground is the site's one loud colour and `text-bg`
     * puts near-black on it at 10.5:1, the same pairing as the current nav
     * cell. Above the drawer's `z-50`, since it outranks anything on the page.
     */}
    <a
      href="#content"
      class="bg-accent text-bg sr-only font-mono text-xs tracking-[0.2em] uppercase focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-[60] focus:px-6 focus:py-3"
    >
      Skip to content
    </a>

    {/*
     * Header, content, footer, all three named here rather than the footer
     * alone. Every page rendered its own `<SiteHeader />` and then opened
     * straight into `<div class="column">`, which left the document with no
     * `<main>` on it anywhere: nothing said where the chrome stopped and the
     * page began, so there was no landmark to jump to and nothing for the skip
     * link above to target. Drawing the shell in one place is what makes the
     * answer the same on every page, including the next one written.
     */}
    <div class="flex-1">
      <SiteHeader search={search} />
      <main id="content"><slot /></main>
    </div>
    <SiteFooter />

    {/*
     * Drawn once, like the footer, so any `data-contact-open` link on any page
     * has a dialog to open. There is only ever one card in the document.
     */}
    <ContactDialog />

    <script>
      /**
       * Hold the scroll position across a link marked `data-hold-scroll`.
       *
       * ClientRouter scrolls a swapped document to the top, which is right when
       * you pivot to another artist and wrong when the page is answering the
       * same question with more of it: a tab switch, or another forty rows. Both
       * of those leave the reader where they were.
       *
       * It sits in the layout rather than in Tabs or LoadMore because both need
       * it and neither implies the other, and one script costs the client budget
       * less than the same script twice.
       *
       * astro:after-swap fires after the router has done its own scrolling
       * (router.js moves the location, then triggers the event), and both run in
       * one task, so this lands last and nothing is painted in between.
       *
       * Both listeners are on `document`, which is the same object after a swap.
       * That is why there is no astro:page-load rebinding: nothing here is bound
       * to an element the swap replaces, so it cannot quietly stop working on
       * the second page a visitor opens. The destination is recorded alongside
       * the offset and checked before restoring, so a click that never navigates
       * cannot strand a position and apply it to some later pivot.
       */
      let held: { href: string; y: number } | null = null;

      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest?.("[data-hold-scroll]");
        held = link instanceof HTMLAnchorElement ? { href: link.href, y: window.scrollY } : null;
      });

      document.addEventListener("astro:after-swap", () => {
        if (held && location.href === held.href) {
          window.scrollTo({ top: held.y, behavior: "instant" });
        }
        held = null;
      });
    </script>
  </body>
</html>

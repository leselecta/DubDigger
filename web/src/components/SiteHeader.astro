---
import SearchField from "./SearchField.astro";

/**
 * Wordmark and search, over the top level navigation.
 *
 * The home page carries its search in the hero, so the header one is suppressed
 * there rather than asking twice for the same thing.
 *
 * The three bars are back, at the foot of this file rather than here, and this
 * time there is a panel behind them. They were removed for standing in for
 * something that was never built; the rule was never that a phone gets four
 * cells it cannot fit.
 */
interface Props {
  search?: boolean;
}

const { search = true } = Astro.props;

/*
 * Which section is being read. Trailing slashes are stripped so "/core-labels/"
 * and "/core-labels" mark the same cell; an artist or label page matches none of
 * them, which is correct, since neither is a section.
 */
const section = Astro.url.pathname.replace(/\/+$/, "") || "/";

/*
 * The one cell, and the two states it can be in.
 *
 * Accent fills the cell rather than tinting the type, so the section you are in
 * is legible at a glance from the far side of the row. `text-bg` is what keeps
 * the label readable on it, and it also has to beat the global `a:hover` rule
 * that would otherwise turn the type accent on an accent ground.
 */
const cell =
  "border-hairline border-l px-5 py-3 font-mono text-[0.6875rem] tracking-[0.14em] whitespace-nowrap uppercase transition-colors";
const resting = "text-ink hover:bg-accent hover:text-bg";
const current = "bg-accent text-bg";

/*
 * The same cell, stacked. It spells the type out again rather than extending
 * `cell` because the two differ in every box property they set, and a Tailwind
 * class list that overrides padding depends on the order the classes happen to
 * be emitted in. Two explicit strings beat one that works by luck.
 *
 * No horizontal padding of its own: the drawer sets the inset once, so the row
 * runs the full width of it and the hairlines stop where the drawer's own
 * padding does. A second inset inside the first would indent the labels away
 * from the edge they are meant to line up with.
 */
const row =
  "border-hairline block border-t py-3.5 font-mono text-[0.6875rem] tracking-[0.14em] uppercase transition-colors";

/*
 * The stack marks the current section in accent type, not an accent ground.
 *
 * A filled cell reads as one item picked out of a row you can see all of. Down
 * a column, full-bleed, it stops being a marker and becomes a band across the
 * drawer — the loudest thing on the phone, for the one piece of information the
 * page underneath is already shouting. The type carries it instead.
 *
 * Hover is spelled out rather than left to the `a:hover` in globals.css, which
 * sits in the `base` layer and loses to any utility that sets a colour.
 */
const rowResting = "text-ink hover:text-accent";
const rowCurrent = "text-accent";

/*
 * Browsing and the Info page, kept apart the way the desktop row keeps them
 * apart, and listed once so the two layouts cannot drift.
 */
const browse = [
  { href: "/", label: "Search Index" },
  { href: "/core-labels", label: "Core Labels" },
  { href: "/core-artists", label: "Core Artists" },
];
const info = [{ href: "/info", label: "Info" }];
---

<header class="border-hairline border-b">
  <div class="column flex h-[76px] items-center justify-between gap-8">
    {/*
     * `pl-2.5` is half the nav cell's `px-5`, so the wordmark is off the column
     * edge and its hairline without being pushed all the way to where "Search
     * Index" starts. It reads as a heading over the row rather than a fourth
     * cell in it, which is what the full 1.25rem made it look like.
     *
     * "(Beta)" is the state of the thing, in the column-header voice: same size
     * and grey as the labels over a list, so it reads as a note about the site
     * rather than a badge. Tracked much tighter than those labels though, at
     * 0.05em against their 0.2em, because it sits beside a wordmark rather than
     * over a column: the brackets already hold it apart, and the wide setting
     * made five letters look like a sixth word. Baseline-aligned, which sits
     * its caps on the wordmark's own bottom edge, and outside the anchor
     * because it is not part of what "go home" means.
     */}
    <div class="flex shrink-0 items-baseline gap-2.5 pl-2.5">
      <a href="/" class="text-xl font-semibold tracking-[-0.02em]">
        dub<span class="text-accent">.</span>digger
      </a>
      <span class="text-ink-faint font-mono text-[0.6875rem] tracking-[0.05em] uppercase">(Beta)</span>
    </div>

    {
      search ? (
        <div class="hidden max-w-[420px] flex-1 sm:block">
          <SearchField size="header" />
        </div>
      ) : (
        <span class="flex-1" />
      )
    }
  </div>
</header>

{/*
 * The top level sections.
 *
 * The type is spelled out rather than reaching for `mono-label` because this
 * row needs its own resting, hover and current colours and the utility fixes
 * one grey for everything. It sits a step below the tab bar: this navigates
 * between sections, the tab bar switches the list you are reading, and the
 * smaller type says which is which. The two mark themselves differently for
 * the same reason: a filled cell here, a heavier underline there.
 *
 * Each cell carries its own left hairline and the group's last cell closes it,
 * so the dividers start at the column edge and stop with the text rather than
 * running the full width the way the band's own rules do.
 *
 * Two groups, split by what they do. Browsing sits left, and Info sits on its
 * own at the right, because it is not a place in the corpus: it answers a
 * question about the tool. The gap between them is the distinction;
 * each group closes its own right edge so neither reads as trailing off.
 *
 * The four cells measure around 580px, so `md` is where they stop fitting a
 * phone with the column's gutters either side. Below it they stack behind the
 * bars. The row keeps `overflow-x-auto` anyway, as the cheap safety valve for
 * a fallback font setting wider than the one this was measured in.
 */}
<nav class="border-hairline border-b" aria-label="Sections">
  <div class="column hidden justify-between overflow-x-auto md:flex">
    <div class="flex shrink-0">
      {
        browse.map(({ href, label }, i) => (
          <a
            href={href}
            aria-current={section === href ? "page" : undefined}
            class:list={[
              cell,
              i === browse.length - 1 && "border-r",
              section === href ? current : resting,
            ]}
          >
            {label}
          </a>
        ))
      }
    </div>

    <div class="flex shrink-0">
      {
        info.map(({ href, label }) => (
          <a
            href={href}
            aria-current={section === href ? "page" : undefined}
            class:list={[cell, "border-r", section === href ? current : resting]}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>

  {/*
   * The phone: a drawer off the left edge, still a native disclosure.
   *
   * `<details>` rather than a button and a script, because the element
   * announces its own state, works with the keyboard, and — the part that
   * would otherwise need code — comes back closed after a ClientRouter swap,
   * since the swap hands over a freshly rendered element with no `open`
   * attribute on it. What changed is where its contents sit: a panel that
   * pushed the page down is now a sheet that slides over it, so opening the
   * menu no longer moves the thing you were reading.
   *
   * The closed bar is the bars and nothing else. It carried the current
   * section's name for a while, on the reasoning that collapsing the row
   * should cost no information, but the page under it already says where you
   * are in type ten times the size — so the label was answering a question
   * that had been answered, and a lone word floating opposite an icon is worse
   * than the empty bar it was filling.
   *
   * The control stays on the right while the drawer comes from the left, and
   * that is deliberate: it is one control in one place, holding still while
   * the sheet moves under it, and it folds into the cross that closes it. A
   * second X inside the drawer would be the same button drawn twice.
   */}
  <details class="md:hidden" data-menu>
    <summary
      class="column text-ink hover:text-accent relative z-50 flex cursor-pointer list-none items-center justify-end py-3.5 transition-colors [&::-webkit-details-marker]:hidden"
    >
      {/*
       * The bars are the whole control, and the name is there for anything
       * that cannot see them. `sr-only` rather than an `aria-label` because a
       * summary takes its accessible name from its contents first, which is
       * the path that behaves the same across screen readers.
       */}
      <span class="sr-only">Menu</span>

      {/*
       * Three bars that become a cross, and it is the same three bars
       * throughout: the outer two swing onto the diagonals while the middle
       * one fades. Two icons swapped by `display` was the first cut and it
       * cannot animate, since there is no frame in which both exist.
       *
       * The transform is in the `<style>` below rather than in class lists
       * because each bar needs an origin, a transition and a two-step
       * transform, and six arbitrary-value variants would be a worse way of
       * writing three rules.
       */}
      {/*
       * `mr-2.5` rather than padding on the summary, which would be a second
       * `padding-inline` fighting the `column` utility's own and resolved by
       * whichever Tailwind happens to emit last. It puts the icon on the same
       * inset as the wordmark above it.
       */}
      <svg
        class="mr-2.5"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="bar top" d="M2 7h20"></path>
        <path class="bar mid" d="M2 12h20"></path>
        <path class="bar bot" d="M2 17h20"></path>
      </svg>
    </summary>

    {/*
     * The ground the drawer sits over. It dims the page rather than hiding it,
     * which is the whole reason a sheet beats a panel here: what you were
     * reading is still there, still in place, waiting.
     *
     * It is also the second way out, and the one a thumb finds first. Escape
     * is the third, and the bars are the first.
     */}
    <div data-scrim class="fixed inset-0 z-40 bg-black/60"></div>

    {/*
     * The drawer.
     *
     * Off the left edge, its own width rather than the full screen: the strip
     * of dimmed page down the right is what says this is a layer over the page
     * and not a new one. `min()` keeps it off the far edge on the narrowest
     * phones, where a fixed 20rem would leave nothing to see through.
     *
     * `overflow-y-auto` because the drawer is as tall as the viewport and its
     * contents are not guaranteed to fit — a short phone in landscape runs out
     * of room around the search field.
     *
     * The two groups keep their distance. Across a row `justify-between` says
     * "these are different kinds of thing" by pushing them to opposite ends;
     * down a column the same sentence is a band of empty ground, so Info sits
     * below a gap rather than as a fourth row in the list. Blank space is the
     * whole argument, which is why there is no extra divider under it: a rule
     * would draw the group boundary twice.
     *
     * Search opens the drawer rather than closing it, which is the one thing
     * the stacked panel had backwards: at the foot of a full-height sheet the
     * field sat a long way from everything else, and it is the likeliest thing
     * to be reached for. It is `sm:hidden` because it exists to fill the hole
     * the header leaves rather than to be a second copy of it. The header
     * field is hidden below `sm` and the section row below `md`, so between
     * the two there is a band where both would show at once; each is on screen
     * exactly where the other is not. The home page suppresses it either way,
     * since the hero is already asking.
     */}
    <div
      data-drawer
      class="border-hairline bg-bg fixed inset-y-0 left-0 z-50 w-[min(20rem,82vw)] overflow-y-auto border-r px-6 py-5"
    >
      {
        search && (
          <div class="mb-6 sm:hidden">
            <SearchField size="header" />
          </div>
        )
      }

      {
        browse.map(({ href, label }) => (
          <a
            href={href}
            aria-current={section === href ? "page" : undefined}
            class:list={[row, section === href ? rowCurrent : rowResting]}
          >
            {label}
          </a>
        ))
      }

      {
        info.map(({ href, label }, i) => (
          <a
            href={href}
            aria-current={section === href ? "page" : undefined}
            class:list={[row, i === 0 && "mt-7", section === href ? rowCurrent : rowResting]}
          >
            {label}
          </a>
        ))
      }
    </div>
  </details>
</nav>

<style>
  /*
   * The bars, and the fold into a cross.
   *
   * `transform-box: view-box` is what makes `center` mean the centre of the
   * icon rather than the centre of each bar. A horizontal line's own bounding
   * box is 20 wide and 0 tall, so under the fill-box default each bar would
   * pivot about itself and the two diagonals would never meet.
   *
   * Read the transform right to left, the way the browser applies it: the bar
   * slides the five units onto the centre line first, then rotates about the
   * icon's middle. Doing it the other way round rotates a bar that is still
   * offset, and the cross comes out lopsided.
   */
  .bar {
    transform-box: view-box;
    transform-origin: center;
    transition:
      transform 220ms ease,
      opacity 140ms ease;
  }

  details[open] .top {
    transform: rotate(45deg) translateY(5px);
  }

  details[open] .bot {
    transform: rotate(-45deg) translateY(-5px);
  }

  /* The middle bar has nowhere to go, so it leaves. Faster than the fold, so
     it is gone before the diagonals arrive rather than crossing them. */
  details[open] .mid {
    opacity: 0;
  }

  /*
   * The slide, and the dimming that runs with it.
   *
   * Both rest in the closed state, so the resting rule is the one that
   * describes an untouched element and `[open]` is what moves it. A drawer
   * that defaulted to open and was pushed off-screen by a second rule would
   * flash across the page in the moment before the stylesheet applied.
   *
   * Material's standard easing, and one duration for both, so the sheet and
   * the ground it darkens read as one movement rather than two.
   */
  [data-drawer] {
    transform: translateX(-100%);
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-scrim] {
    opacity: 0;
    transition: opacity 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  details[open] [data-drawer] {
    transform: none;
  }

  details[open] [data-scrim] {
    opacity: 1;
  }

  /*
   * The cross unfolds with the drawer, not after it, and the drawer slides
   * back out before the element stops being open.
   *
   * Closing keeps `open` set for as long as the slide runs, because the drawer
   * has to stay in the document to be slid. So `[open]` is the wrong thing to
   * read on the way out: it would hold the cross and the sheet in place
   * through the whole close and snap them back at the end. The script writes
   * what was actually asked for, and these undo the four rules above.
   *
   * Same specificity, so it is source order that decides — keep them last. No
   * script means no `data-shown`, and the plain `[open]` rules stand: the
   * drawer opens and closes without animating, which is the right thing to
   * degrade to.
   */
  details[data-shown="false"] [data-drawer] {
    transform: translateX(-100%);
  }

  details[data-shown="false"] [data-scrim] {
    opacity: 0;
  }

  details[data-shown="false"] .top,
  details[data-shown="false"] .bot {
    transform: none;
  }

  details[data-shown="false"] .mid {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    [data-drawer],
    [data-scrim] {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Slide the drawer in and out.
   *
   * All the movement is in CSS; what this buys is the two frames `<details>`
   * does not give you. Opening, the drawer goes from display-none to laid out
   * in one frame, and a transform set in that frame has no previous value to
   * transition from. Closing, the element stops being open the moment the
   * browser says so, and a sheet that is not in the document cannot slide
   * anywhere. So the script holds both ends: it opens the element off-canvas
   * and moves it one frame later, and it keeps the element open until the
   * slide back has finished.
   *
   * This is the fourth item on the client budget, at a few hundred bytes, and
   * the first one that buys decoration rather than a capability. It replaces
   * the height animation that did the same job for the stacked panel, so the
   * budget gains a behaviour rather than a line item.
   */
  const DURATION = 280;

  function setUp(details: HTMLDetailsElement) {
    const summary = details.querySelector("summary");
    const scrim = details.querySelector("[data-scrim]");
    if (!summary) return;

    let timer = 0;

    function set(opening: boolean) {
      clearTimeout(timer);

      // The page must not scroll behind the sheet: a drawer that moves with
      // the thing it is covering reads as part of the page rather than over
      // it, and on a phone the scroll would be the drawer's own by accident.
      document.documentElement.style.overflow = opening ? "hidden" : "";

      if (opening) {
        // Open it in the closed position, then let one frame land before
        // asking for the other end. Without the reflow between the two the
        // browser coalesces them and the drawer is simply there.
        details.dataset.shown = "false";
        details.open = true;
        void details.offsetHeight;
        details.dataset.shown = "true";
        return;
      }

      details.dataset.shown = "false";

      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        details.open = false;
        return;
      }

      // Hold the element open for the length of the slide. A timer rather
      // than `transitionend`, which never fires if the transition was never
      // eligible to run — a drawer that could not be closed would be a worse
      // bug than one that closes a frame late.
      timer = window.setTimeout(() => {
        details.open = false;
      }, DURATION);
    }

    summary.addEventListener("click", (event) => {
      // The browser would toggle `open` immediately, which is exactly the jump
      // being replaced. Every state change above is made by hand instead.
      event.preventDefault();

      // Intent, not state: a details that is sliding shut is still `open`, so
      // asking the element would read the direction backwards on a reversal.
      set(details.dataset.shown !== "true");
    });

    scrim?.addEventListener("click", () => set(false));

    // Bound to the details rather than the document, so it costs nothing when
    // the menu is shut and there is no listener to tidy up after a swap. The
    // drawer's own links and field are inside it, so focus is too.
    details.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.dataset.shown === "true") set(false);
    });
  }

  // Fires on the first load and again after every ClientRouter navigation.
  document.addEventListener("astro:page-load", () => {
    // A drawer link is a navigation, and the swap hands back a closed menu
    // with the lock still on the html element it did not replace.
    document.documentElement.style.overflow = "";
    document.querySelectorAll<HTMLDetailsElement>("details[data-menu]").forEach(setUp);
  });
</script>

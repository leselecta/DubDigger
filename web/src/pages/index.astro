---
import Base from "@/layouts/Base.astro";
import SearchField from "@/components/SearchField.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { getCorpusStats, getDbPath } from "@/lib/db";
import { search } from "@/lib/queries";
import { GRADE_SHADE, gradeWord } from "@/lib/view";

const q = Astro.url.searchParams.get("q") ?? undefined;
const stats = getCorpusStats();
const results = q ? search(q) : null;

/*
 * A query, and something to answer it with. The second half is what keeps the
 * page from having no `<h1>` at all: with no database the results block is
 * never rendered, so the heading that stands in for the headline is not there
 * either, and dropping the headline as well left the page with none.
 */
const searching = Boolean(q) && stats !== null;

const columns: [string, number][] = stats
  ? [
      ["Artists", stats.artists],
      ["Labels", stats.labels],
      ["Releases", stats.releases],
    ]
  : [];

/** The column widths, shared by the header row and every result, so they line up. */
const RESULT_GRID = "grid-cols-[1fr_4.5rem] md:grid-cols-[1fr_5.5rem_11rem_5rem]";

/**
 * How close to the scene a result sits.
 *
 * Shown because breadth is only an asset when a distant act looks distant.
 * Mozart is genuinely in this corpus, on 85 releases that really do credit
 * someone here, and saying so is honest where hiding him would not be.
 *
 * Whether they arrived as a collaborator or as a label mate is a different
 * question from how close they are, and the artist page answers it; a column
 * being scanned forty rows at a time wants one scale, not a grade for some rows
 * and a reason for others.
 *
 * Labels are graded on the same five words, from a measure of their own: how
 * much of what they released is in the cluster. The underlying test is not the
 * artist one, and it does not need to be. One column asking one question in one
 * vocabulary beats two scales sharing a heading, and until a label had four
 * steps this column had a two-step scale pretending to be a four-step one.
 *
 * The words and their shades are in `view.ts`, because the suggestion dropdown
 * now shows the same grade on the way to this page and the two must not drift.
 */

/** Graded up here, so the row below reads as markup rather than as a function. */
const rows = (results?.hits ?? []).map((hit) => ({ hit, grade: gradeWord(hit.relevance) }));
---

{/*
 * The one page that had no description of its own, and that is how the footer
 * became its snippet. Every other page passes one; this one fell back to the
 * layout's default, which opened with the headline verbatim. The default is
 * fixed too, but the home page states its own for the same reason the rest do:
 * a fallback is what a page gets when nobody decided, and this is the page a
 * search result is most likely to be.
 *
 * It states what the tool is, in one clause, and stops. "Dig the Extended
 * Scene" is the headline's job and is already on screen, so the description
 * does not repeat it. An earlier version opened with the move instead ("Type an
 * artist, see who they worked with..."), which read as an instruction to
 * somebody who had not yet decided whether to click.
 */}
<Base
  search={false}
  description="A map of the dub techno scene and its neighbours, built from Discogs credit data."
>
  {/*
   * Searching drops the tagline and keeps everything else. A headline
   * announcing what the site is has done its job by the time someone has
   * typed into it, and the results are what they came back for.
   *
   * On a phone the band is sized to a figures cell's `py-10`, so the headline
   * reads as one block in a stack of blocks rather than as a hero with air
   * around it. The top is 16 rather than 10 because the two edges are not built
   * the same: below the tagline the 40px is followed by the 24px the figures
   * wrapper holds above its own hairline, so 40 and 40 comes out visibly
   * lopsided. 64 against 40 is what reads as equal. The desktop values are the
   * design's and are left alone: there the band is the whole first screen and
   * the air is the point.
   */}
  <div
    class:list={[
      "column text-center",
      searching ? "pt-14 pb-10 md:pb-12" : "pt-16 pb-10 md:pt-[130px] md:pb-24",
    ]}
  >
    <Eyebrow>The Dub Techno Index</Eyebrow>

    {
      !searching && (
        <h1 class="text-hero text-ink-strong mt-3 leading-[0.92] font-bold tracking-[-0.04em] md:mt-9">
          Dig the Extended Scene<span class="text-accent">.</span>
          <br />
          Dub Techno First<span class="text-accent">.</span>
        </h1>
      )
    }

    <div class:list={["mx-auto max-w-[640px]", searching ? "mt-8" : "mt-16"]}>
      <SearchField size="hero" value={q} />
    </div>
    <p class="mt-[18px] font-mono text-xs tracking-[0.14em] text-ink-faint uppercase">
      Search artists · labels · releases
    </p>
  </div>

  {
    stats === null ? (
      /*
       * An empty result that looks like an answer is worse than an honest "no
       * data". That principle starts here: before any ingest has run, say so
       * plainly rather than rendering a search box that silently returns nothing.
       */
      <div class="column pb-20 md:pb-32">
        <div class="border-hairline max-w-[720px] border-t pt-10">
          <h2 class="mono-label">No database yet</h2>
          <p class="text-body text-ink-muted mt-4">
            Nothing has been ingested. The app expects a precomputed SQLite file at:
          </p>
          <p class="text-ink-faint mt-4 font-mono text-xs break-all">{getDbPath()}</p>
          <p class="text-body text-ink-muted mt-4">
            Run the ingest steps in <span class="font-mono text-sm">ingest/</span>, then publish the
            result into <span class="font-mono text-sm">web/data/</span>.
          </p>
        </div>
      </div>
    ) : (
      <>
        {searching && results && (
          <div class="column pb-20 md:pb-24">
            {/*
             * The count is the heading, because on a results page it is what
             * the page is: the headline above it has done its job by the time
             * someone has typed, and dropping it left the document with no
             * `<h1>` on it at all. Same classes, so nothing moves — it was
             * already the one line saying what you are looking at.
             *
             * A miss takes the accent, a hit does not. It is the one heading
             * here that has to be read rather than counted past: the answer is
             * that there is no answer, and the paragraph under it is the part
             * that matters. The headline's two accent stops are not on the page
             * once someone has typed, so this spends the colour that just came
             * free rather than adding to it.
             *
             * On a phone it carries a rule above it, because there the field
             * and its answer are a single column of text and nothing says where
             * the searching stops and the results start. At `md` the band above
             * is wide and obviously a header, so the rule would be drawing a
             * boundary that is already visible. Inside the column, so it insets
             * to the gutters like the figures band rather than running edge to
             * edge like the footer, and 40px under it: a figures cell's `py-10`
             * is what a hairline is followed by everywhere else on a phone.
             */}
            <h1
              class:list={[
                "mono-label border-hairline mb-6 border-t pt-10 md:border-t-0 md:pt-0",
                results.hits.length === 0 && "text-accent",
              ]}
            >
              {results.hits.length === 0
                ? `Nothing found for “${q}”`
                : results.truncated
                  ? `Closest ${results.hits.length} for “${q}”`
                  : `${results.hits.length} found for “${q}”`}
            </h1>

            {/*
             * The paragraph takes no top padding: the heading's own `mb-6` is
             * the gap, which is the same 1.5rem a LabelledBand puts between a
             * mono label and the prose beside it. A `py-10` here stacked a
             * second gap on top of that and floated the sentence away from the
             * label it belongs to.
             */}
            {results.hits.length === 0 ? (
              <p class="text-body text-ink-muted max-w-[720px] pb-10">
                This corpus is a slice centred on dub techno, not all of Discogs, so plenty of real
                artists and labels are legitimately absent. That is the boundary working, not a gap.
                Or this may mean that the entry doesn't actually exist on Discogs.
              </p>
            ) : (
              <>
                <div
                  class:list={[
                    "border-hairline text-ink-faint grid gap-x-[22px] border-b pb-3 font-mono text-[0.6875rem] tracking-[0.2em] uppercase",
                    RESULT_GRID,
                  ]}
                >
                  <span>Name</span>
                  <span>Releases</span>
                  <span class="hidden md:block">Relevance</span>
                  <span class="hidden md:block">Type</span>
                </div>

                <ul>
                  {rows.map(({ hit, grade }) => (
                    <li
                      class:list={[
                        "border-hairline-soft grid items-baseline gap-x-[22px] border-b py-[18px]",
                        RESULT_GRID,
                      ]}
                    >
                      <a
                        href={`/${hit.kind}/${hit.id}`}
                        class="link-rule text-row min-w-0 justify-self-start font-bold tracking-[-0.01em]"
                      >
                        {hit.name}
                      </a>

                      <span class="text-ink-faint font-mono text-[0.8125rem] font-medium tabular-nums">
                        {hit.releaseCount.toLocaleString("en-GB")}
                      </span>

                      {/*
                       * Both of these fold under the name below `md`, where the
                       * header above has no column left to name them from. So
                       * they carry their own heading down with them and read
                       * "Relevance: medium", "Type: label" on a phone. The
                       * label stays `text-ink-faint` in each, under the value's
                       * own colour, so the grade's shade is still the thing the
                       * eye lands on.
                       *
                       * `mt-2` because the grid has no row gap and the name
                       * above carries `link-rule`, so the underline's bottom
                       * and this line's top were the same y. A short name hides
                       * that: the rule is only as wide as the word. A name that
                       * wraps fills the column, and then a full-width rule sits
                       * flat on "Relevance:" with nothing between them. Only
                       * the first of the two moves; the pair stays tight,
                       * because they are two lines of one block.
                       *
                       * `md:sr-only` rather than `md:hidden`, which is the
                       * whole difference between a label that stops being drawn
                       * and one that stops existing. Above `md` the heading is
                       * back in its column, so nothing should show it twice —
                       * but `display: none` also takes it out of the accessible
                       * tree, and the header row is a sibling `<div>` with no
                       * way to say which column it names. A row read aloud came
                       * out "Basic Channel, 47, high, artist". Out of flow and
                       * still spoken, every value keeps the word for what it is.
                       */}
                      <span class="col-start-1 mt-2 font-mono text-xs tracking-[0.1em] uppercase md:col-start-3 md:mt-0">
                        <span class="text-ink-faint md:sr-only">Relevance:</span>
                        <span class={GRADE_SHADE[grade]}>{grade}</span>
                      </span>

                      <span class="text-ink col-start-1 font-mono text-xs tracking-[0.1em] uppercase md:col-start-4">
                        <span class="text-ink-faint md:sr-only">Type:</span>
                        {hit.kind}
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )}

        <div class="column pt-6 pb-20 md:pb-32">
          <dl class="border-hairline grid border-t sm:grid-cols-3" data-figures>
            {columns.map(([label, value], i) => (
              <div
                class:list={[
                  "px-0 py-10 sm:px-10 sm:py-14",
                  i < columns.length - 1 && "border-hairline border-b sm:border-r sm:border-b-0",
                ]}
              >
                <dt class="mono-label">{label}</dt>
                <dd
                  class="text-stat text-ink-strong mt-3 font-bold tracking-[-0.03em] tabular-nums"
                  data-count={value}
                >
                  {value.toLocaleString("en-GB")}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </>
    )
  }

  <script>
    /**
     * The three figures count up the first time they come into view.
     *
     * The size of this corpus is the claim the bottom of the page makes, and a
     * number that arrives rather than sits there is what makes half a million
     * releases read as half a million. It is the one thing on the page whose
     * trigger the server cannot know: whether the band has been scrolled to.
     *
     * The real figures are rendered by the server and only handed to the script
     * once it is going to animate them. So no JavaScript, and a reader who has
     * asked for less motion, both get the true number with nothing to notice.
     */
    const DURATION = 1400;

    function countUp(figures: HTMLElement[]) {
      const start = performance.now();

      const step = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        const eased = 1 - (1 - t) ** 3;

        for (const figure of figures) {
          const target = Number(figure.dataset.count);
          figure.textContent = Math.round(target * eased).toLocaleString("en-GB");
        }

        if (t < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    }

    // Fires on the first load and again after every ClientRouter navigation.
    document.addEventListener("astro:page-load", () => {
      const band = document.querySelector<HTMLElement>("[data-figures]");
      if (!band || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const figures = [...band.querySelectorAll<HTMLElement>("[data-count]")];
      if (figures.length === 0) return;

      for (const figure of figures) figure.textContent = "0";

      /*
       * All three run together, off the band rather than off each figure: they
       * are one statement in three parts, and staggering them would read as
       * three separate arrivals. The negative bottom margin holds the start
       * until the band is properly on screen instead of peeking at the edge.
       */
      const seen = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          seen.disconnect();
          countUp(figures);
        },
        { rootMargin: "0px 0px -12% 0px" },
      );

      seen.observe(band);
    });
  </script>
</Base>
